---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PageNav from "../components/PageNav.astro";
import StructuredData from "../components/StructuredData.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import AuthorBio from "../components/AuthorBio.astro";

const faqs = [
  { q: "What does Tibetan food taste like?", a: "Tibetan cuisine is hearty, warming, and surprisingly mild. Think yak meat, barley, dairy, and root vegetables. The flavors are earthy and savory rather than spicy. Influences come from Sichuan (numbing pepper), Nepal/India (curries and momos), and Central Asia (breads and grilled meats). Most travelers find it more approachable than they expected." },
  { q: "Is it safe to eat street food in Lhasa?", a: "Generally yes, with common sense. Stick to stalls with high turnover and cooked-to-order food. Avoid raw vegetables washed in tap water. The sweet tea houses are perfectly safe and a quintessential Lhasa experience. Bottled or boiled water for drinking is essential." },
  { q: "Are there vegetarian options in Lhasa?", a: "Yes, but you need to know where to look. Many Tibetan Buddhist monasteries serve vegetarian meals. Lhasa has a growing number of dedicated vegetarian restaurants, especially around the Barkhor area. 'Vegetarian' in Tibet sometimes includes yak broth — clarify explicitly." },
  { q: "Can I find halal food in Lhasa?", a: "Yes. Lhasa has a significant Muslim Hui community with several halal restaurants concentrated near the Lhasa Great Mosque (east of Barkhor Street). Look for green signage with Arabic script. Hui cuisine blends Chinese and Central Asian flavors: hand-pulled noodles, lamb skewers, and flatbreads are staples." },
  { q: "What should I eat to help with altitude sickness?", a: "Focus on complex carbohydrates (tsampa, bread, noodles) for sustained energy, and avoid heavy fatty meals that your body struggles to digest at altitude. Drink sweet tea or ginger tea — both help with nausea. Garlic is traditionally used for altitude adaptation. Stay away from alcohol for at least the first 48 hours." },
];
---

<BaseLayout canonical="https://www.tibet-lhasa-potala.com/lhasa-food/" title="Lhasa Food: 8 Tibetan Dishes & Where to Eat [2026]" description="What to eat in Lhasa: tsampa, yak meat, momos and sweet tea, where to find them near Barkhor, vegetarian and halal options, and what meals cost." ogImage="https://www.tibet-lhasa-potala.com/images/og-potala-palace.webp"
  authorName="Tenzin Dorje" authorUrl="/about/#tenzin-dorje" datePublished="2026-03-05" dateModified="2026-08-06">
>
  <StructuredData type="Article" data={{ title: "Lhasa Food Guide", description: "Complete guide to Tibetan food in Lhasa: must-try dishes, best restaurants near Potala Palace, dietary options, and food safety tips.", url: "/lhasa-food/", datePublished: "2026-01-01", dateModified: "2026-08-06" }} />
  <StructuredData type="BreadcrumbList" data={{ items: [{ name: "Home", url: "/" }, { name: "Food Guide", url: "/lhasa-food/" }] }} />
  <StructuredData type="FAQPage" data={{ faqs }} />
  <StructuredData type="Person" data={{ name: "Tenzin Dorje", description: "Lhasa-based Researcher & Cultural Guide", url: "/about/#tenzin-dorje" }} />

  <PageHero title="Lhasa Food Guide" subtitle="What to eat, where to eat, and how to eat well near Potala Palace. Tibetan classics, hidden tea houses, vegetarian and halal picks, and food safety at altitude." breadcrumb="Food Guide" updated="August 2026" image="/images/tibetan-cuisine.webp" />

  <!-- Stats Bar -->
  <div class="max-w-5xl mx-auto px-4 md:px-6 pt-4">
    <div class="stats-bar">
      <div class="stat-item">
        <span class="stat-number">8</span>
        <span class="stat-label">Must-Try Dishes</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">15&ndash;25</span>
        <span class="stat-label">Momos Plate (CNY)</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">5&ndash;8</span>
        <span class="stat-label">Sweet Tea Thermos (CNY)</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">60+</span>
        <span class="stat-label">Restaurants Near Potala</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">40&ndash;120</span>
        <span class="stat-label">Avg Meal Cost (CNY)</span>
      </div>
    </div>
  </div>

  <!-- Featured Dish Cards -->
  <section class="max-w-5xl mx-auto px-4 md:px-6 py-14">
    <h2 class="section-title mb-3">Must-Try Tibetan Dishes</h2>
    <p class="section-subtitle">Built for survival at altitude: calorie-dense, warming, and made from what the plateau provides.</p>
    <div class="dish-grid">
      <div class="dish-card">
        <div class="dish-card-img">
          <img src="/images/tibetan-food.webp" alt="Tsampa and yak butter tea on a Tibetan table" loading="lazy" width="600" height="400" />
        </div>
        <div class="dish-card-body">
          <span class="dish-tag">Staple</span>
          <h3>Tsampa <small class="dish-chinese">粌粑</small></h3>
          <p>Roasted barley flour mixed with yak butter tea, kneaded into dough by hand. Tibet's daily bread for centuries &mdash; nutty, earthy, and it grows on you. Eaten with butter and sugar it's genuinely enjoyable.</p>
        </div>
      </div>
      <div class="dish-card">
        <div class="dish-card-img">
          <img src="/images/tibetan-cuisine.webp" alt="Tibetan yak meat dishes on a traditional table" loading="lazy" width="600" height="400" />
        </div>
        <div class="dish-card-body">
          <span class="dish-tag">Protein</span>
          <h3>Yak Meat <small class="dish-chinese">牦牛肉</small></h3>
          <p>Dried yak jerky, yak steak, yak momos, yak noodle soup, yak hotpot. Leaner and slightly sweeter than beef, with a subtle gaminess. The spiced dried jerky strips sold everywhere are addictively chewy.</p>
        </div>
      </div>
      <div class="dish-card">
        <div class="dish-card-body dish-card-no-img">
          <span class="dish-tag">Most Popular</span>
          <h3>Momos <small class="dish-chinese">藏包子</small></h3>
          <p>The most foreigner-friendly dish in Tibet. Steamed or fried dumplings with yak, vegetables, or potato-cheese. Served with fiery Sichuan chili dipping sauce. A plate of 10 costs CNY 15&ndash;25 and makes a complete meal.</p>
        </div>
      </div>
      <div class="dish-card">
        <div class="dish-card-body dish-card-no-img">
          <span class="dish-tag">Comfort Food</span>
          <h3>Thenthuk <small class="dish-chinese">藏面片</small></h3>
          <p>Irregular hand-pulled wheat noodles in yak-bone broth with vegetables and shredded yak. Tibet's chicken soup &mdash; warm, filling, and gentle on the stomach. Every Tibetan restaurant does a version.</p>
        </div>
      </div>
      <div class="dish-card">
        <div class="dish-card-body dish-card-no-img">
          <span class="dish-tag">Social Drink</span>
          <h3>Sweet Tea <small class="dish-chinese">甜茶</small></h3>
          <p>Black tea, milk, and sugar brewed in large aluminum kettles. Served by the thermos. Closer to Hong Kong milk tea &mdash; sweet, creamy, completely addictive. A small thermos costs CNY 5&ndash;8. Find a tea house and watch Lhasa go by.</p>
        </div>
      </div>
      <div class="dish-card">
        <div class="dish-card-body dish-card-no-img">
          <span class="dish-tag">Acquired Taste</span>
          <h3>Yak Butter Tea <small class="dish-chinese">酥油茶</small></h3>
          <p>Salty, oily, intensely Tibetan. Churned from yak butter, brick tea, and salt. Most foreigners politely sip and set it aside. But it helps with altitude acclimatization and chapped lips. Try it once &mdash; you'll remember it.</p>
        </div>
      </div>
      <div class="dish-card">
        <div class="dish-card-body dish-card-no-img">
          <span class="dish-tag">Dessert</span>
          <h3>Yak Yogurt <small class="dish-chinese">酸奶</small></h3>
          <p>Thick, tangy, naturally set &mdash; closer to Greek yogurt. Served with sugar on the side or mixed with rice and raisins. Street vendors sell it in small clay pots near Barkhor Street. The food travelers miss most after leaving.</p>
        </div>
      </div>
      <div class="dish-card">
        <div class="dish-card-body dish-card-no-img">
          <span class="dish-tag">Street Food</span>
          <h3>Sha Phaley &amp; Balep</h3>
          <p>Sha phaley: deep-fried bread pocket stuffed with seasoned yak and cabbage &mdash; a Tibetan empanada. Plain Tibetan flatbread (balep) is a solid breakfast with yak butter or honey. Both CNY 3&ndash;8 each.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Restaurant Category Grids -->
  <section class="max-w-5xl mx-auto px-4 md:px-6 pb-14">
    <h2 class="section-title mb-3">Restaurants Near Potala Palace</h2>
    <p class="section-subtitle">After three hours of climbing Potala's stairs at 3,700 meters, you will be hungry. Here's where to go.</p>

    <div class="restaurant-tiers">
      <div class="resto-tier">
        <div class="tier-head">
          <span class="tier-badge tier-badge-close">5-Min Walk</span>
          <h3>Stepping Out of the Palace</h3>
        </div>
        <div class="tier-grid">
          <div class="resto-card">
            <h4>Lhasa Kitchen</h4>
            <div class="resto-meta">
              <span class="resto-price">CNY 40&ndash;70</span>
              <span class="resto-feature">English Menu</span>
            </div>
            <p>Reliable Tibetan standards in a clean sit-down setting. Momos, thenthuk, yak steak. Ideal for a first Tibetan meal without intimidation.</p>
          </div>
          <div class="resto-card">
            <h4>Potala Tea Houses</h4>
            <div class="resto-meta">
              <span class="resto-price">CNY 15&ndash;30</span>
              <span class="resto-feature">Most Authentic</span>
            </div>
            <p>Small, unmarked tea houses cluster on Beijing East Road just east of the palace. No English, no menu &mdash; point at what others are eating. Sweet tea and momos.</p>
          </div>
        </div>
      </div>

      <div class="resto-tier">
        <div class="tier-head">
          <span class="tier-badge tier-badge-walk">10&ndash;15 Min Walk</span>
          <h3>Toward Barkhor Street</h3>
        </div>
        <div class="tier-grid">
          <div class="resto-card">
            <h4>Dunya Restaurant</h4>
            <div class="resto-meta">
              <span class="resto-price">CNY 50&ndash;90</span>
              <span class="resto-feature">Rooftop + English</span>
            </div>
            <p>A Lhasa institution. Tibetan, Nepali, and Western food. Yak sizzler, momos, and surprisingly decent pizza. Rooftop with distant Potala views.</p>
          </div>
          <div class="resto-card">
            <h4>House of Shambhala</h4>
            <div class="resto-meta">
              <span class="resto-price">CNY 80&ndash;120</span>
              <span class="resto-feature">Sunset Views</span>
            </div>
            <p>Potala views from the rooftop terrace. More expensive but the setting justifies it. Book ahead for sunset.</p>
          </div>
          <div class="resto-card">
            <h4>Makye Ame</h4>
            <div class="resto-meta">
              <span class="resto-price">CNY 70&ndash;120</span>
              <span class="resto-feature">Historic Ambiance</span>
            </div>
            <p>The most famous restaurant in Lhasa, on the corner of Barkhor Street. Wooden interiors, low ceilings, windows overlooking the circumambulation. Unforgettable atmosphere.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Vegetarian & Halal Section -->
  <section class="dietary-section">
    <div class="max-w-5xl mx-auto px-4 md:px-6 py-14">
      <div class="dietary-grid">
        <div class="dietary-panel">
          <div class="dietary-panel-head">
            <span class="dietary-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 8c0 0 2-2 4 0 2 2 2 6 0 8"/></svg>
            </span>
            <h2>Vegetarian &amp; Vegan</h2>
          </div>
          <div class="dietary-cards">
            <div class="d-card">
              <h4>Pure Land Vegetarian</h4>
              <span class="d-price">CNY 28 buffet</span>
              <p>All-vegetarian near Barkhor. Rotating Tibetan and Chinese dishes. Spartan setting, excellent value, genuinely tasty.</p>
            </div>
            <div class="d-card">
              <h4>Tianchu Miaoxiang</h4>
              <span class="d-price">CNY 60&ndash;100</span>
              <p>Upscale Buddhist vegetarian near Jokhang Temple. Creative mock-meat, beautiful presentation, temple-adjacent atmosphere.</p>
            </div>
            <div class="d-card">
              <h4>Monastery Halls</h4>
              <span class="d-price">Donation-based</span>
              <p>Simple vegetarian meals at Jokhang and Sera monasteries. The most culturally authentic vegetarian experience available.</p>
            </div>
          </div>
          <div class="d-tip">Learn <em>nga tse zhimbu</em> (I am vegetarian) or show <code>我吃素</code>. Ask if dishes contain yak broth &mdash; it sneaks into many "vegetable" soups.</div>
        </div>

        <div class="dietary-panel">
          <div class="dietary-panel-head">
            <span class="dietary-icon halal-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 3v18M12 3v18M18 3v18"/><path d="M3 6h18M3 12h18M3 18h18"/></svg>
            </span>
            <h2>Halal Food</h2>
          </div>
          <p class="d-intro">Lhasa's Muslim Hui community has been here for centuries. Concentrated around the Lhasa Great Mosque (east of Barkhor).</p>
          <div class="dietary-cards">
            <div class="d-card">
              <h4>Hand-Pulled Noodles</h4>
              <span class="d-price">CNY 15&ndash;25</span>
              <p>Watch the chef stretch dough into noodles. Lamb or beef broth, fresh vegetables, chili oil.</p>
            </div>
            <div class="d-card">
              <h4>Lamb Skewers</h4>
              <span class="d-price">CNY 3&ndash;5 each</span>
              <p>Grilled over charcoal, seasoned with cumin and chili. Sizzling, smoky, and served fresh off the grill.</p>
            </div>
            <div class="d-card">
              <h4>Nang Bread</h4>
              <span class="d-price">CNY 2&ndash;5</span>
              <p>Central Asian-style flatbread from tandoor ovens. Perfect for soaking up soups and stews.</p>
            </div>
          </div>
          <div class="d-tip halal-tip">Look for green signage, Arabic lettering, and the halal certification logo (清真). Most halal restaurants are on Jiangsu Road and streets around the mosque.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pull Quote -->
  <section class="max-w-3xl mx-auto px-4 md:px-6 py-12">
    <blockquote class="pull-quote">
      <p>Sweet tea is Lhasa's social glue. Find a tea house, order a thermos, and watch the city go by. It's the cheapest and most authentic experience in Tibet.</p>
      <cite>&mdash; Every traveler who spent an afternoon in a Lhasa tea house</cite>
    </blockquote>
  </section>

  <!-- Food Safety Tips Grid -->
  <section class="max-w-5xl mx-auto px-4 md:px-6 pb-14">
    <h2 class="section-title mb-3">Food Safety &amp; Practical Tips</h2>
    <p class="section-subtitle">Altitude changes how your body handles food. Here's what to know.</p>
    <div class="tips-grid">
      <div class="tip-card">
        <div class="tip-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2a7 7 0 0 1 7 7c0 5.5-7 13-7 13S5 14.5 5 9a7 7 0 0 1 7-7z"/><circle cx="12" cy="9" r="2"/></svg>
        </div>
        <h4>Water Safety</h4>
        <p>Never drink tap water. Bottled water is CNY 2&ndash;3 everywhere. Boil water for 3+ minutes at this altitude &mdash; most hotels provide a kettle.</p>
      </div>
      <div class="tip-card">
        <div class="tip-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        </div>
        <h4>Altitude &amp; Digestion</h4>
        <p>Digestion slows at altitude. Eat smaller meals more frequently. Avoid massive heavy dinners &mdash; they disrupt already-affected sleep.</p>
      </div>
      <div class="tip-card">
        <div class="tip-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
        </div>
        <h4>Altitude Appetite Loss</h4>
        <p>Many people lose appetite at altitude &mdash; normal and temporary. Sweet tea and thenthuk are the go-to foods when nothing else appeals.</p>
      </div>
      <div class="tip-card">
        <div class="tip-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        </div>
        <h4>Raw Vegetables</h4>
        <p>Avoid raw salads and unpeeled fruit at street stalls. The water used to wash them may not be safe for foreign stomachs.</p>
      </div>
      <div class="tip-card">
        <div class="tip-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h4>Tipping</h4>
        <p>Not expected or customary in Tibet. Round up the bill if you want, but no one will notice if you don't.</p>
      </div>
      <div class="tip-card">
        <div class="tip-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
        </div>
        <h4>Payment</h4>
        <p>WeChat Pay and Alipay dominate. Cash (RMB) is accepted everywhere. Set up Alipay TourPass before your trip. Foreign credit cards are rarely accepted.</p>
      </div>
      <div class="tip-card">
        <div class="tip-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        </div>
        <h4>Spice Caution</h4>
        <p>Sichuan pepper (ma la) is common in Lhasa. If you're not used to it, start mild. The numbing sensation can be alarming if unexpected.</p>
      </div>
    </div>
  </section>

  <!-- Image Break -->
  <div class="image-break">
    <img src="/images/tibetan-teahouse.webp" alt="Traditional Tibetan tea house interior in Lhasa" loading="lazy" width="1200" height="600" />
    <div class="image-break-caption">A traditional Tibetan tea house &mdash; the social heart of Lhasa</div>
  </div>

  <section class="max-w-3xl mx-auto px-4 md:px-6 pb-12">
    <h2 class="text-2xl font-bold mb-6">Food Questions Answered</h2>
    <FaqAccordion faqs={faqs} />
  </section>
  <section class="max-w-3xl mx-auto px-4 md:px-6 pb-4">
    <AuthorBio slug="tenzin-dorje" datePublished="2026-03-05" dateModified="2026-08-06" />
  </section>



  <PageNav prev={{ href: "/lhasa-attractions/", label: "Attractions" }} next={{ href: "/hotels-potala-view/", label: "Hotels" }} />
</BaseLayout>

<style is:inline>
  /* Stats Bar */
  .stats-bar {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .stat-item {
    padding: 1.5rem 1rem;
    text-align: center;
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .stat-item:last-child { border-right: none; }
  .stat-number {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 500;
    color: var(--color-accent);
    letter-spacing: -0.01em;
  }
  .stat-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-subtle);
    font-weight: 500;
    line-height: 1.3;
  }

  /* Section */
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-text);
    line-height: 1.2;
  }
  .section-subtitle {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 60ch;
    margin-bottom: 2.5rem;
  }

  /* Dish Grid */
  .dish-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }
  .dish-card {
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
  }
  .dish-card-img {
    overflow: hidden;
  }
  .dish-card-img img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
    transition: transform 0.5s;
  }
  .dish-card:hover .dish-card-img img { transform: scale(1.04); }
  .dish-card-body {
    padding: 1.75rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .dish-card-no-img { border-top: none; }
  .dish-tag {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }
  .dish-card-body h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }
  .dish-chinese {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-text-subtle);
    font-weight: 400;
  }
  .dish-card-body p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  /* Restaurant Tiers */
  .restaurant-tiers { display: flex; flex-direction: column; gap: 2.5rem; }
  .resto-tier { }
  .tier-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .tier-head h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-text);
  }
  .tier-badge {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    padding: 0.3rem 0.8rem;
    background: var(--color-surface-alt);
