---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PageNav from "../components/PageNav.astro";
import StructuredData from "../components/StructuredData.astro";
import AuthorBio from "../components/AuthorBio.astro";
import FaqAccordion from "../components/FaqAccordion.astro";

const visitSteps = [
  { name: "Book Your Tickets", text: "Reserve online through the official platform or via a registered travel agency at least 3-5 days ahead. During peak season (May-October), tickets sell out 5-7 days in advance. The daily visitor cap is 2,300 people." },
  { name: "Get Your Permits", text: "Foreign visitors need a Tibet Travel Permit (TTP) arranged through a travel agency before arriving in Tibet. Processing takes 7-10 business days. Your agency will also handle the Potala ticket reservation as part of your tour package." },
  { name: "Arrive in Lhasa and Acclimatize", text: "Fly into Lhasa Gonggar Airport or take the Qinghai-Tibet railway. Spend at least 1-2 days in Lhasa before attempting Potala Palace. The altitude (3,650m) affects most visitors, and the climb to the palace entrance is demanding." },
  { name: "Arrive at the Palace Early", text: "On the day of your visit, arrive at the east entrance gate 30 minutes before your reserved time slot. Have your passport and ticket confirmation ready. The climb from the entrance gate to the palace doors takes 20-30 minutes uphill." },
  { name: "Explore the White Palace", text: "The eastern section contains the former living quarters and ceremonial halls of the Dalai Lamas. Key rooms: the Great East Hall (ceremonies and enthronements), the Dalai Lama's living chambers, and the seminary. Photography is allowed in outdoor courtyards only." },
  { name: "Visit the Red Palace", text: "The western section is the religious heart of the complex. Key sights: the gilded stupa tombs of the 5th through 13th Dalai Lamas (the 5th Dalai Lama's stupa stands 14.8 meters tall and is covered in nearly 4 tonnes of gold), the Dharma Cave (the oldest surviving structure from the 7th century), and the main assembly hall with its extraordinary murals." },
  { name: "See the Golden Roofs", text: "Crowning the Red Palace, the gilded bronze roofs are visible from across Lhasa. Access is included in your ticket. The view from here — gold against blue sky with prayer flags in the foreground — is one of the most photographed scenes in Tibet." },
  { name: "Exit Through the West Gate", text: "The visit follows a one-way route ending at the western exit. From here, you can walk downhill to the Potala Palace Square for exterior photos, or continue to nearby attractions like the Tibet Museum or Norbulingka Palace." },
];

const faqs = [
  { q: "How do I book Potala Palace tickets?", a: "Tickets must be reserved online in advance through the official platform or via a travel agency. During peak season (May-October), tickets sell out days ahead. Book at least 3-5 days in advance." },
  { q: "Can I buy tickets at the entrance?", a: "On-site ticket sales are extremely limited and not guaranteed. Always book in advance. The palace has a daily visitor cap of approximately 2,300 people." },
  { q: "What are the opening hours?", a: "9:30 AM to 3:30 PM (last entry). Arrive at least 30 minutes before your reserved time slot. The palace closes earlier than most attractions." },
  { q: "How difficult is the climb?", a: "At 3,700m altitude, climbing the steep stone steps can be challenging even for fit visitors. Take it slow and allow 30-45 minutes just to reach the entrance. Wait 1-2 days after arriving in Lhasa to acclimatize." },
  { q: "Is there a dress code?", a: "Yes. Shoulders and knees should be covered. Remove hats inside chapels. Avoid shorts and revealing clothing. Comfortable walking shoes are essential -- the stone steps are uneven." },
];
---

<BaseLayout canonical="https://www.tibet-lhasa-potala.com/visit" title="How to Visit Potala Palace | Complete 2026 Guide" description="Complete 2026 guide: tickets, hours, routes, interior room guide, facilities, and insider tips for visiting Potala Palace in Lhasa, Tibet." ogImage="https://www.tibet-lhasa-potala.com/images/og-potala-palace.webp" authorName="Sarah Chen" authorUrl="/about/#sarah-chen" datePublished="2026-01-15" dateModified="2026-08-06">
<StructuredData type="Article" data={{ title: "How to Visit Potala Palace", description: "Complete 2026 guide to Potala Palace visits: tickets, hours, routes, interior guide, and practical tips.", url: "/visit/" }} />
<StructuredData type="BreadcrumbList" data={{ items: [{ name: "Home", url: "/" }, { name: "Visit Guide", url: "/visit/" }] }} />
<StructuredData type="HowTo" data={{ name: "How to Visit Potala Palace", description: "Step-by-step guide to visiting Potala Palace in Lhasa, Tibet. Booking, permits, arrival, and palace tour.", steps: visitSteps }} />
<StructuredData type="FAQPage" data={{ faqs }} />
<StructuredData type="Person" data={{ name: "Sarah Chen", description: "Senior Travel Writer & Tibet Specialist, 6+ visits to Tibet across four seasons.", url: "/about/#sarah-chen" }} />

<PageHero title="How to Visit Potala Palace" subtitle="The complete 2026 guide: tickets, routes, interior room guide, facilities, and everything you need to know before you go." breadcrumb="Visit Guide" updated="August 2026" image="/images/gallery-potala-chakpori-hill.webp" />

<!-- QUICK STATS -->
<div class="page-stats">
  <div class="page-stat"><span class="page-stat-num">200</span><span class="page-stat-label">CNY Peak</span></div>
  <div class="page-stat"><span class="page-stat-num">9:30</span><span class="page-stat-label">AM Opens</span></div>
  <div class="page-stat"><span class="page-stat-num">2,300</span><span class="page-stat-label">Daily Cap</span></div>
  <div class="page-stat"><span class="page-stat-num">2-3</span><span class="page-stat-label">Hours</span></div>
</div>

<!-- TICKET INFO -->
<article class="content-page">
  <div class="content-section">
    <h2>Ticket Information</h2>
    <div class="ticket-grid">
      <div class="ticket-card">
        <span class="ticket-card-season">May – October</span>
        <span class="ticket-card-price">CNY 200</span>
        <span class="ticket-card-label">Peak Season</span>
      </div>
      <div class="ticket-card">
        <span class="ticket-card-season">November – April</span>
        <span class="ticket-card-price">CNY 100</span>
        <span class="ticket-card-label">Off-Peak</span>
      </div>
      <div class="ticket-card">
        <span class="ticket-card-season">Students / Seniors</span>
        <span class="ticket-card-price">50% Off</span>
        <span class="ticket-card-label">With valid ID</span>
      </div>
      <div class="ticket-card">
        <span class="ticket-card-season">Under 1.2m</span>
        <span class="ticket-card-price">Free</span>
        <span class="ticket-card-label">With adult</span>
      </div>
    </div>
  </div>

  <!-- IMAGE BREAK -->
  <div class="content-image-break">
    <img src="/images/gallery-potala-night.webp" alt="Potala Palace at night" loading="lazy" decoding="async" />
    <span class="content-image-cap">The Potala illuminated after dark — Lhasa's skyline icon</span>
  </div>

  <div class="content-section">
    <h2>How to Book</h2>
    <div class="booking-grid">
      <div class="booking-card"><span class="booking-num">01</span><div><strong>Through a travel agency</strong><p>The most reliable method for foreign visitors. Your agency handles everything including the Tibet Travel Permit and ticket reservation.</p></div></div>
      <div class="booking-card"><span class="booking-num">02</span><div><strong>Online platform</strong><p>The official reservation platform opens slots 7 days in advance. You will need your passport and Tibet Travel Permit.</p></div></div>
    </div>
  </div>

  <div class="content-section">
    <h2>Choose Your Route</h2>
    <div class="route-grid">
      <div class="route-card">
        <img src="/images/gallery-potala-golden-roofs.webp" alt="Golden roofs" loading="lazy" decoding="async" />
        <div class="route-card-body">
          <span class="route-tag">1 Hour</span>
          <h3>Express Route</h3>
          <p>East gate → White Palace ceremonial halls → Red Palace stupa chapels → West exit. Covers the highlights if you are short on time or struggling with the altitude.</p>
        </div>
      </div>
      <div class="route-card">
        <img src="/images/gallery-potala-chakpori-hill.webp" alt="Potala panorama" loading="lazy" decoding="async" />
        <div class="route-card-body">
          <span class="route-tag">3 Hours</span>
          <h3>Full Experience</h3>
          <p>Chakpori Hill photos → East gate → White Palace → Red Palace (stupas, Dharma Cave, murals) → Golden Roofs → West exit. Allow extra time — everything takes longer at 3,700m.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- PULL QUOTE -->
  <div class="pull-quote">
    <p>"The walk up leaves you breathless — both from the altitude and the sheer scale of what towers above you."</p>
  </div>

  <div class="content-section">
    <h2>Inside the Palace</h2>
    <div class="palace-grid">
      <div class="palace-column">
        <h3>The White Palace <span style="font-weight:400;font-size:0.875rem;color:var(--color-text-subtle);">Potrang Karpo</span></h3>
        <p class="palace-intro">The eastern section was the winter residence and administrative center of the Dalai Lamas. Completed in 1648.</p>
        <div class="palace-highlight"><strong>Great East Hall</strong><span>The largest hall, used for enthronement and religious ceremonies. Massive silk thangkas hang from the ceiling.</span></div>
        <div class="palace-highlight"><strong>Dalai Lama's Chambers</strong><span>Top floor rooms preserved with original furnishings and a private chapel. Stunning Lhasa valley views.</span></div>
        <div class="palace-highlight"><strong>The Seminary</strong><span>Where monks studied Buddhist philosophy. Walls lined with ancient texts and scriptures.</span></div>
      </div>
      <div class="palace-column">
        <h3>The Red Palace <span style="font-weight:400;font-size:0.875rem;color:var(--color-text-subtle);">Potrang Marpo</span></h3>
        <p class="palace-intro">The spiritual heart of the Potala, built after the 5th Dalai Lama's death in 1682.</p>
        <div class="palace-highlight"><strong>Stupa Tombs</strong><span>Eight gilded stupas containing Dalai Lama remains. The 5th's stands 14.8m tall, covered in 3,721 kg of gold with turquoise, coral, and pearls.</span></div>
        <div class="palace-highlight"><strong>Dharma Cave</strong><span>The oldest structure from the 7th century. King Songtsen Gampo meditated here. Ancient statues inside.</span></div>
        <div class="palace-highlight"><strong>Great West Hall</strong><span>Main assembly room with towering pillars and murals depicting the 5th Dalai Lama's life.</span></div>
      </div>
    </div>
  </div>

  <div class="content-section">
    <h2>Golden Roofs</h2>
    <div class="golden-roofs-wrap">
      <img src="/images/gallery-potala-golden-roofs.webp" alt="Potala golden roofs" loading="lazy" decoding="async" />
      <p>Seven gilded bronze roofs crown the stupa chapels atop the Red Palace. Bronze tiles covered in gold leaf gleam so brightly at midday they are visible from across Lhasa. Surrounded by gilded railings, bells, and decorative finials — this is one of the finest photo spots inside the complex.</p>
    </div>
  </div>

  <div class="content-section">
    <h2>Before You Go</h2>
    <div class="tips-grid">
      <div class="tip-item"><span class="tip-icon">&#8990;</span><strong>Arrive 30 min early</strong><span>The climb from the east gate to the palace entrance takes 20-30 minutes uphill.</span></div>
      <div class="tip-item"><span class="tip-icon">&#9888;</span><strong>No water inside</strong><span>Liquids are not allowed. Hydrate before entry, bring snacks for after your visit.</span></div>
      <div class="tip-item"><span class="tip-icon">&#9974;</span><strong>No photos in chapels</strong><span>Allowed in courtyards and outdoors. Strictly prohibited inside halls. No tripods.</span></div>
      <div class="tip-item"><span class="tip-icon">&#9730;</span><strong>Acclimatize first</strong><span>Do not visit Potala on your first day in Lhasa. Your body needs 1-2 days to adjust.</span></div>
      <div class="tip-item"><span class="tip-icon">&#8594;</span><strong>One-way route</strong><span>The path goes east to west. You cannot backtrack — make sure you have seen everything.</span></div>
      <div class="tip-item"><span class="tip-icon">&#9787;</span><strong>Cover shoulders & knees</strong><span>Remove hats in chapels. No shorts or revealing clothing. Wear comfortable walking shoes.</span></div>
    </div>
  </div>
</article>

<!-- FACILITIES -->
<article class="content-page" style="background:var(--color-surface-alt);padding-top:4rem;padding-bottom:4rem;margin-top:2rem;">
  <div class="max-w-4xl mx-auto px-6 md:px-10">
    <h2 style="font-family:var(--font-display);font-weight:500;font-size:1.75rem;margin-bottom:2rem;letter-spacing:-0.01em;">Facilities & Services</h2>
    <div class="facilities-grid">
      <div class="facility-card"><span class="facility-icon">&#128663;</span><strong>Parking</strong><span>Limited at east entrance. Fills by mid-morning in peak season. Taxis drop at east gate.</span></div>
      <div class="facility-card"><span class="facility-icon">&#128701;</span><strong>Restrooms</strong><span>Available near entrance and inside. Basic facilities — use before the long climb.</span></div>
      <div class="facility-card"><span class="facility-icon">&#127869;</span><strong>Food & Drink</strong><span>No food inside. Eat breakfast before visiting. Tea houses and restaurants nearby after exit.</span></div>
      <div class="facility-card"><span class="facility-icon">&#127911;</span><strong>Audio Guide</strong><span>CNY 30 rental. Available in 8 languages including English (new for 2026).</span></div>
      <div class="facility-card"><span class="facility-icon">&#128090;</span><strong>Baggage Check</strong><span>Large bags, tripods, and water bottles must be checked. Bring only a small day bag.</span></div>
      <div class="facility-card"><span class="facility-icon">&#127873;</span><strong>Souvenirs</strong><span>Small stalls near the exit. For better selection, visit Barkhor Street 2 km away.</span></div>
    </div>
  </div>
</article>

<section class="max-w-3xl mx-auto px-4 md:px-6 pb-12 pt-12">
  <h2 style="font-family:var(--font-display);font-weight:500;font-size:1.75rem;margin-bottom:2rem;letter-spacing:-0.01em;">Visit Questions Answered</h2>
  <FaqAccordion faqs={faqs} />
</section>

<section class="max-w-3xl mx-auto px-4 md:px-6 pb-4">
  <AuthorBio slug="sarah-chen" datePublished="2026-01-15" dateModified="2026-08-06" />
</section>

<PageNav prev={{ href: "/", label: "Home" }} next={{ href: "/permits/", label: "Travel Permits" }} />
</BaseLayout>

<style>
  .content-page { max-width: 62rem; margin: 0 auto; padding: 0 1.5rem; }
  .content-section { margin-top: 3.5rem; }
  .content-section:first-child { margin-top: 2rem; }
  .content-section h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.75rem;
    letter-spacing: -0.01em;
    margin-bottom: 1.5rem;
  }
  .content-section h3 { font-family: var(--font-display); font-weight: 500; font-size: 1.25rem; margin-bottom: 0.75rem; }

  .page-stats { display: flex; justify-content: center; border-bottom: 1px solid var(--color-border); padding: 1.5rem; background: #F9F8F6; }
  .page-stat { flex: 1; text-align: center; padding: 0.75rem; border-right: 1px solid var(--color-border); }
  .page-stat:last-child { border-right: none; }
  .page-stat-num { display: block; font-size: 1.5rem; font-weight: 500; font-family: var(--font-display); color: var(--color-text); }
  .page-stat-label { display: block; font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-subtle); margin-top: 0.25rem; }

  .ticket-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); }
  .ticket-card { background: white; padding: 1.75rem 1.25rem; text-align: center; display: flex; flex-direction: column; gap: 0.35rem; }
  .ticket-card-season { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-subtle); }
  .ticket-card-price { font-size: 1.75rem; font-weight: 500; font-family: var(--font-display); color: var(--color-text); }
  .ticket-card-label { font-size: 0.75rem; color: var(--color-text-muted); }

  .booking-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); }
  .booking-card { background: white; padding: 1.75rem; display: flex; gap: 1.25rem; }
  .booking-num { font-size: 1.5rem; font-weight: 500; font-family: var(--font-display); color: var(--color-accent); opacity: 0.5; flex-shrink: 0; line-height: 1; }
  .booking-card strong { display: block; font-size: 0.9375rem; margin-bottom: 0.35rem; }
  .booking-card p { font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.6; margin: 0; }

  .route-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); }
  .route-card { background: white; overflow: hidden; }
  .route-card img { width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block; }
  .route-card-body { padding: 1.5rem; }
  .route-tag { font-size: 0.625rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); display: block; margin-bottom: 0.5rem; }
  .route-card h3 { font-size: 1.125rem; font-weight: 500; margin-bottom: 0.5rem; }
  .route-card p { font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.6; }

  .pull-quote { border-top: 2px solid var(--color-text); border-bottom: 2px solid var(--color-text); padding: 2.5rem 0; margin: 3rem 0; text-align: center; }
  .pull-quote p { font-family: var(--font-display); font-size: 1.375rem; font-style: italic; color: var(--color-text); line-height: 1.5; max-width: 30rem; margin: 0 auto; }

  .palace-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.5rem; }
  .palace-column h3 { margin-bottom: 0.75rem; }
  .palace-intro { font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: 1.25rem; line-height: 1.6; }
  .palace-highlight { padding: 0.75rem 0; border-bottom: 1px solid var(--color-border); }
  .palace-highlight:last-child { border-bottom: none; }
  .palace-highlight strong { display: block; font-size: 0.875rem; margin-bottom: 0.2rem; }
  .palace-highlight span { display: block; font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.55; }

  .golden-roofs-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start; }
  .golden-roofs-wrap img { width: 100%; aspect-ratio: 4/3; object-fit: cover; }
  .golden-roofs-wrap p { font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.8; margin: 0; }

  .tips-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); }
  .tip-item { background: white; padding: 1.5rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .tip-icon { font-size: 1.25rem; }
  .tip-item strong { font-size: 0.8125rem; }
  .tip-item span:last-child { font-size: 0.75rem; color: var(--color-text-muted); line-height: 1.5; }

  .facilities-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); }
  .facility-card { background: white; padding: 1.5rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .facility-icon { font-size: 1.5rem; }
  .facility-card strong { font-size: 0.8125rem; }
  .facility-card span:last-child { font-size: 0.75rem; color: var(--color-text-muted); line-height: 1.5; }

  .content-image-break { margin: 3rem 0; }
  .content-image-break img { width: 100%; aspect-ratio: 21/9; object-fit: cover; display: block; }
  .content-image-cap { display: block; font-size: 0.6875rem; color: var(--color-text-subtle); margin-top: 0.5rem; text-transform: uppercase; letter-spacing: 0.06em; }

  @media (max-width: 768px) {
    .ticket-grid { grid-template-columns: repeat(2, 1fr); }
    .page-stat { padding: 0.5rem; }
    .page-stat-num { font-size: 1.25rem; }
    .route-grid { grid-template-columns: 1fr; }
    .palace-grid { grid-template-columns: 1fr; }
    .golden-roofs-wrap { grid-template-columns: 1fr; }
    .tips-grid { grid-template-columns: 1fr; }
    .facilities-grid { grid-template-columns: 1fr; }
    .booking-grid { grid-template-columns: 1fr; }
    .pull-quote p { font-size: 1.125rem; }
  }
</style>
