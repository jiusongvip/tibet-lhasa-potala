  .arch-card-header h3 { font-size: 1.5rem; font-weight: 500; margin-bottom: 0.25rem; }
  .arch-white { border-bottom: 3px solid #E8E4D9; }
  .arch-red { border-bottom: 3px solid #A8452F; }
  .arch-card-label { font-size: 0.625rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text-subtle); display: block; margin-bottom: 0.25rem; }
  .arch-card-tibetan { font-size: 0.75rem; color: var(--color-text-subtle); font-style: italic; }
  .arch-card-body { padding: 1.5rem 1.75rem; }
  .arch-card-body p { font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.7; margin: 0; }

