  .figure-card p { font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.6; margin: 0; }

  @media (max-width: 768px) {
    .page-stat-num { font-size: 1.25rem; }
    .page-stat { padding: 0.5rem; }
    .timeline-item { flex-direction: column; }
    .timeline-marker { width: 44px; height: 44px; font-size: 1rem; }
    .arch-grid, .arch-details { grid-template-columns: 1fr; }
    .treasure-card { grid-template-columns: 1fr; }
    .treasures-sub-grid { grid-template-columns: 1fr; }
    .pull-quote p { font-size: 1.125rem; }
    .content-image-break img, .timeline-spacer img { aspect-ratio: 16/9; }
  }
</style>
