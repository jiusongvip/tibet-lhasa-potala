  .treasure-card-body p { font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.7; }

  .treasures-sub-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); border-top: none; }
  .treasure-sub-card { background: white; padding: 1.75rem; }
  .treasure-sub-card h3 { font-size: 1.125rem; margin-bottom: 0.75rem; }
  .treasure-sub-card p { font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.65; margin: 0; }

