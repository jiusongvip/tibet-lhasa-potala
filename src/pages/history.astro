  .treasures-grid { display: flex; flex-direction: column; gap: 1px; margin-top: 1.25rem; }
  .treasure-card { display: grid; grid-template-columns: 1fr 1fr; gap: 0; background: var(--color-border); border: 1px solid var(--color-border); }
