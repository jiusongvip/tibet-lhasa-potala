  .timeline-body a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 2px; }
  .timeline-spacer { margin: 2rem -1.5rem; }
  .timeline-spacer img { width: 100%; aspect-ratio: 21/9; object-fit: cover; display: block; }

  .content-image-break { margin: 3rem -1.5rem; }
  .content-image-break img { width: 100%; aspect-ratio: 21/9; object-fit: cover; display: block; }
  .content-image-cap { display: block; font-size: 0.6875rem; color: var(--color-text-subtle); margin-top: 0.5rem; text-transform: uppercase; letter-spacing: 0.06em; padding: 0 1.5rem; }

  .pull-quote { border-top: 2px solid var(--color-text); border-bottom: 2px solid var(--color-text); padding: 2.5rem 0; margin: 3rem 0; text-align: center; }
