---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page Not Found | Potala Guide" description="The page you are looking for does not exist." noindex={true}>
  <section class="min-h-[60dvh] flex items-center justify-center px-6 text-center">
    <div>
      <span class="text-7xl font-bold text-[var(--color-text-subtle)] block mb-4">404</span>
      <h1 class="text-2xl md:text-3xl font-bold text-[var(--color-text)] mb-3">Page Not Found</h1>
      <p class="text-[var(--color-text-muted)] max-w-md mx-auto mb-8">
        The page you are looking for does not exist or has been moved. Try one of our guides below.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/" class="btn-primary">Go Home</a>
        <a href="/visit" class="btn-outline">Visit Guide</a>
        <a href="/permits" class="btn-outline">Travel Permits</a>
      </div>
    </div>
  </section>
</BaseLayout>
