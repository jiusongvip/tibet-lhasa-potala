const faqs = [
  { q: "Do I need to cover my head inside temples?", a: "Yes. Remove hats and caps when entering any temple or monastery in Tibet. This applies to both men and women. It is a sign of respect toward the Buddha, the Dharma, and the Sangha." },
  { q: "What should I wear when visiting monasteries?", a: "Long pants or skirts covering the knees, and shirts covering the shoulders. Avoid shorts, tank tops, and revealing clothing. This is not just cultural etiquette. Many monasteries will deny entry to improperly dressed visitors." },
  { q: "Which direction do I walk around religious sites?", a: "Always clockwise with your left shoulder toward the shrine. This is called kora. You will see Tibetans circumambulating temples, stupas, and prayer wheels in this direction. Walking counter-clockwise is associated with the Bon religion and can cause offense in Buddhist spaces." },
  { q: "Can I take photos of monks and pilgrims?", a: "Ask first. A simple gesture toward your camera and a smile is universal. Many monks are happy to be photographed if asked respectfully. Never photograph people in prayer without permission. Inside temple halls, photography is almost always prohibited." },
  { q: "Is it OK to touch someone's head?", a: "No. The head is considered the most sacred part of the body in Tibetan culture. Never pat a child on the head, even affectionately. Similarly, do not point the soles of your feet toward people or religious objects." },
];

const pageTitle = "Tibet Travel Etiquette 2026 | Do's & Don'ts";
