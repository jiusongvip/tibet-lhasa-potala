  @media (max-width: 480px) {
    .t-step { gap: 14px; padding: 14px 0; }
    .t-step-marker { width: 36px; height: 36px; }
  }
</style>

<script is:inline>
  const answers = {};
  function selectAlt(el, step) {
    const stepDiv = document.getElementById('step-' + step);
    stepDiv.querySelectorAll('.alt-btn').forEach(b => b.classList.remove('selected'));
    el.classList.add('selected');
    answers[step] = el.dataset.value;
    setTimeout(() => {
      stepDiv.style.display = 'none';
      if (step < 3) {
        document.getElementById('step-' + (step + 1)).style.display = 'block';
      } else {
        showResult();
      }
    }, 200);
  }
  function showResult() {
    const result = document.getElementById('alt-result');
    let title, body, level;
    if (answers[3] === 'serious') {
      title = 'Consult your doctor first';
      body = 'At 3,700m, Potala Palace is higher than most ski resorts. With your health concerns, altitude sickness is a real risk. Talk to your doctor at least a month before travel. They can prescribe Diamox and advise whether this trip is safe for you. If you do go, fly into Lhasa and spend 3+ days acclimatizing before attempting the palace.';
      level = 'caution';
    } else if (answers[1] === 'sea' && answers[2] === 'soon') {
      title = 'Tight timeline — but doable with planning';
      body = 'Coming from sea level with only 2 weeks to prepare means altitude will hit you hard. Book a hotel in Lhasa for at least 2 nights before your palace visit. Fly in rather than taking the train. Consider asking your doctor about Diamox. Do NOT schedule Potala for your first day.';
      level = 'plan';
    } else if (answers[1] === 'high') {
      title = 'You are well positioned';
      body = 'Living at or traveling from high altitude gives you a real advantage. You will still feel the 3,700m climb but noticeably less than sea-level visitors. Budget 1 acclimatization day in Lhasa. Focus on permits, tickets, timing.';
      level = 'good';
    } else {
      title = 'You will be fine — with preparation';
      body = 'Your starting elevation and timeline give you room to acclimatize. Arrive 1-2 days before your palace visit. Drink 3-4 liters of water per day. Walk slowly on the stairs. Pack ibuprofen for altitude headaches. Enjoy the experience.';
      level = 'good';
    }
    const borderColor = level === 'caution' ? 'caution' : level === 'plan' ? 'plan' : 'good';
    const altIcon = borderColor === 'caution' ? '⚠️' : borderColor === 'plan' ? '✈️' : '✅';
    result.innerHTML = '<div class="alt-result-new alt-result-' + borderColor + '"><div class="alt-result-header"><span class="alt-result-icon">' + altIcon + '</span><h3>' + title + '</h3></div><p class="alt-result-body">' + body + '</p><div class="alt-result-actions"><button onclick="resetCheck()" class="btn-outline text-sm">Start over</button><a href="/travel-tips" class="btn-primary text-sm">Read altitude guide</a></div></div>';
    result.style.display = 'block';
  }
  const costAnswers = {};
  function selectCostBtn(el, step) {
    const stepDiv = document.getElementById('cost-step-' + step);
    stepDiv.querySelectorAll('.cost-btn').forEach(b => b.classList.remove('selected'));
    el.classList.add('selected');
    costAnswers[step] = el.dataset.value;
    setTimeout(() => {
      stepDiv.style.display = 'none';
      if (step < 2) {
        document.getElementById('cost-step-' + (step + 1)).style.display = 'block';
      } else if (step === 2) {
        document.getElementById('cost-step-3').style.display = 'block';
      }
    }, 200);
  }
  function showCostResult() {
    const people = parseInt(costAnswers[1]) || 1;
    const isPeak = costAnswers[2] === 'peak';
    const ticketPrice = isPeak ? 200 : 100;
    const tickets = people * ticketPrice;
    const guide = document.getElementById('cost-guide').checked ? 300 : 0;
    const audio = document.getElementById('cost-audio').checked ? 30 * people : 0;
    const photo = document.getElementById('cost-photo').checked ? 150 : 0;
    const total = tickets + guide + audio + photo;
    let breakdown = '<p style="font-size:0.875rem;color:var(--color-text-muted);margin-bottom:4px">' + people + ' x ' + (isPeak ? 'Peak season' : 'Off-peak') + ' ticket: <strong>CNY ' + tickets + '</strong></p>';
    if (guide) breakdown += '<p style="font-size:0.875rem;color:var(--color-text-muted);margin-bottom:4px">English guide: <strong>CNY ' + guide + '</strong></p>';
    if (audio) breakdown += '<p style="font-size:0.875rem;color:var(--color-text-muted);margin-bottom:4px">Audio guide: <strong>CNY ' + audio + '</strong></p>';
    if (photo) breakdown += '<p style="font-size:0.875rem;color:var(--color-text-muted);margin-bottom:4px">Photography pass: <strong>CNY ' + photo + '</strong></p>';
    const result = document.getElementById('cost-result');
    result.innerHTML = '<div class="cost-result-box"><div class="cost-result-total"><span class="cost-result-label">Total estimated cost</span><span class="cost-result-amount">CNY ' + total + '</span></div><div class="cost-result-breakdown">' + breakdown + '</div><p class="cost-result-note">This is an estimate. Does not include Tibet Travel Permit fees or accommodation.</p><div class="cost-result-actions"><button onclick="resetCost()" class="btn-outline text-sm">Start over</button><a href="/visit" class="btn-primary text-sm">Full visit guide</a></div></div>';
    result.style.display = 'block';
  }
  function resetCost() {
    Object.keys(costAnswers).forEach(k => delete costAnswers[k]);
    document.querySelectorAll('#cost-calc .cost-btn').forEach(b => b.classList.remove('selected'));
    document.getElementById('cost-guide').checked = false;
    document.getElementById('cost-audio').checked = false;
    document.getElementById('cost-photo').checked = false;
    document.getElementById('cost-step-1').style.display = 'block';
    document.getElementById('cost-step-2').style.display = 'none';
    document.getElementById('cost-step-3').style.display = 'none';
    document.getElementById('cost-result').style.display = 'none';
  }
  function resetCheck() {
    Object.keys(answers).forEach(k => delete answers[k]);
    document.querySelectorAll('.alt-btn').forEach(b => b.classList.remove('selected'));
    document.getElementById('step-1').style.display = 'block';
    document.getElementById('step-2').style.display = 'none';
    document.getElementById('step-3').style.display = 'none';
    document.getElementById('alt-result').style.display = 'none';
  }
</script>
</BaseLayout>
