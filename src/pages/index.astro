import BaseLayout from "../layouts/BaseLayout.astro";import HeroSection from "../components/HeroSection.astro";import QuickInfoBar from "../components/QuickInfoBar.astro";import FaqAccordion from "../components/FaqAccordion.astro";import StructuredData from "../components/StructuredData.astro";import PhotoGallery from "../components/PhotoGallery.astro";const faqs = [  { q: "Do I need a special permit to visit Potala Palace?", a: "Yes. Foreign visitors need a Tibet Travel Permit to enter Tibet, plus a separate ticket reservation for Potala Palace. We cover the full process in our Permits Guide." },  { q: "How much do tickets cost in 2026?", a: "Peak season (May-Oct): CNY 200. Off-peak (Nov-Apr): CNY 100. Students and seniors may qualify for 50% discounts. Online reservation fee is an additional CNY 5." },  { q: "How long should I plan for the visit?", a: "A thorough visit takes 2-3 hours. The palace has 13 stories and over 1,000 rooms. Budget extra time for the climb: altitude makes everything harder than it looks." },  { q: "Can I take photos inside?", a: "Photography is allowed in outdoor areas and courtyards. Inside the chapels and halls, photography is strictly prohibited. Tripods require special permission." },  { q: "What is the best time of day to visit?", a: "Morning (9:30-11:00 AM) for clear mountain views. Afternoon light is beautiful for exterior photography. Avoid midday crowds on weekends." },  { q: "Is Potala Palace wheelchair accessible?", a: "Accessibility is limited due to the historic nature of the building and steep staircases. Some lower levels are accessible; upper floors are not. Contact your tour operator in advance for assistance." },  { q: "How do I deal with the altitude?", a: "Lhasa is at 3,650m and Potala Palace adds 50m of steep stairs. Most visitors need 1-2 days to acclimatize. Do not plan Potala for your first day in Lhasa. Hydrate aggressively, walk slowly, and consider Diamox." },  { q: "How far in advance should I start planning?", a: "Ideally 6-8 weeks before travel. Tibet Travel Permit takes 7-10 business days. Potala tickets sell out 5-7 days ahead in peak season. Flights and train tickets open 15 days before departure. Start the permit process first." },  { q: "What is the closest airport to Potala Palace?", a: "Lhasa Gonggar Airport (LXA), approximately 60 km southwest of the city. Airport shuttle bus (CNY 30, 70 min) or taxi (CNY 200-250, 60 min) to reach the palace area." },  { q: "What language do I need inside the palace?", a: "Most signage is in Chinese and Tibetan. English audio guides are available for rent (CNY 30). We recommend downloading a guided tour app or hiring an English-speaking guide through your travel agency." },];
