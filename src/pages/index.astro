        <span class="section-tag">Interactive Tool</span>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-text)]">Visit Cost Calculator</h2>
        <p class="text-[var(--color-text-muted)] mt-1">Estimate your total Potala Palace visit cost in 30 seconds.</p>
      </div>
      <div id="cost-calc">
        <div class="cost-step" id="cost-step-1">
          <p class="cost-step-label">How many adults?</p>
          <div class="cost-btn-group">
            <button class="cost-btn" data-value="1" onclick="selectCostBtn(this,1)"><span class="cost-btn-num">1</span><span class="cost-btn-text">person</span></button>
            <button class="cost-btn" data-value="2" onclick="selectCostBtn(this,1)"><span class="cost-btn-num">2</span><span class="cost-btn-text">people</span></button>
