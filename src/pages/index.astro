---
import BaseLayout from "../layouts/BaseLayout.astro";import HeroSection from "../components/HeroSection.astro";import FaqAccordion from "../components/FaqAccordion.astro";import StructuredData from "../components/StructuredData.astro";import PhotoGallery from "../components/PhotoGallery.astro";const faqs = [  { q: "Do I need a special permit to visit Potala Palace?", a: "Yes. Foreign visitors need a Tibet Travel Permit to enter Tibet, plus a separate ticket reservation for Potala Palace. We cover the full process in our Permits Guide." },  { q: "How much do tickets cost in 2026?", a: "Peak season (May-Oct): CNY 200. Off-peak (Nov-Apr): CNY 100. Students and seniors may qualify for 50% discounts. Online reservation fee is an additional CNY 5." },  { q: "How long should I plan for the visit?", a: "A thorough visit takes 2-3 hours. The palace has 13 stories and over 1,000 rooms. Budget extra time for the climb: altitude makes everything harder than it looks." },  { q: "Can I take photos inside?", a: "Photography is allowed in outdoor areas and courtyards. Inside the chapels and halls, photography is strictly prohibited. Tripods require special permission." },  { q: "What is the best time of day to visit?", a: "Morning (9:30-11:00 AM) for clear mountain views. Afternoon light is beautiful for exterior photography. Avoid midday crowds on weekends." },  { q: "Is Potala Palace wheelchair accessible?", a: "Accessibility is limited due to the historic nature of the building and steep staircases. Some lower levels are accessible; upper floors are not. Contact your tour operator in advance for assistance." },  { q: "How do I deal with the altitude?", a: "Lhasa is at 3,650m and Potala Palace adds 50m of steep stairs. Most visitors need 1-2 days to acclimatize. Do not plan Potala for your first day in Lhasa. Hydrate aggressively, walk slowly, and consider Diamox." },  { q: "How far in advance should I start planning?", a: "Start at least 8 weeks before departure. Tibet Travel Permit takes 7-10 business days. Chinese visa takes 1-2 weeks. Peak season tickets sell out 5-7 days ahead. We break down the full timeline below." },];
---

<BaseLayout canonical="https://tibet-lhasa-potala.com" heroImage="/images/hero-potala-palace.webp" ogType="website" authorName="Potala Guide Editorial Team" authorUrl="/about" datePublished="2026-01-01" dateModified="2026-08-06"  title="Potala Palace Guide 2026 | Tickets, Permits & Tips"  description="Plan your Potala Palace visit: 2026 ticket prices, permits, best photo spots, and altitude tips from local experts in Lhasa."  ogImage="https://tibet-lhasa-potala.com/images/og-potala-palace.webp">
<StructuredData    type="TouristAttraction"    data={{      description: "The world's highest ancient palace, a UNESCO World Heritage site in Lhasa, Tibet. Complete 2026 visitor guide with ticket prices, permits, altitude tips, and photography spots.",      url: "/",    }}  />
<StructuredData type="BreadcrumbList" data={{ items: [{ name: "Home", url: "/" }] }} />
<StructuredData type="FAQPage" data={{ faqs }} />

<!-- HERO -->
<section class="hero-wrap">
  <HeroSection
    title="Potala Palace,<br/>Lhasa"
    subtitle="The world's highest ancient palace, rising 3,700 metres above the Tibetan Plateau. A UNESCO World Heritage site spanning thirteen centuries. The most complete English-language guide — updated August 2026."
    cta={{ href: "/visit", label: "Plan Your Visit" }}
    imageUrl="/images/hero-potala-palace.webp"
  />
  <div class="hero-badge">
    <span class="hero-badge-dot"></span>
    Updated August 2026
    <span class="hero-badge-sep">|</span>
    UNESCO World Heritage
  </div>
</section>

<!-- TRUST BAR -->
<div class="hero-info-panel">
  <div class="hero-info-trust">
    <span class="hi-trust"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg> UNESCO 1994</span>
    <span class="hi-trust"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg> 1,300+ Years</span>
    <span class="hi-trust"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Updated Aug 2026</span>
    <span class="hi-trust"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg> Most Complete Guide</span>
  </div>
</div>

<!-- WHY VISIT -->
<section class="section" id="why-visit">
  <div class="max-w-6xl mx-auto">
    <div class="section-header">
      <span class="section-tag">Why Potala</span>
      <h2 class="section-title">Not just a palace.<br/>A world unto itself.</h2>
      <p style="color:var(--color-text-muted); margin-top:1rem; max-width:36rem;">Three reasons this place stays with you long after you descend the Red Hill.</p>
    </div>
    <div class="why-grid">
      <div class="why-card">
        <div class="why-card-media">
          <img src="/images/gallery-potala-chakpori-hill.webp" alt="Panoramic view of Potala Palace from Chakpori Hill" loading="lazy" decoding="async" width="600" height="400" />
        </div>
        <div class="why-card-body">
          <h3 class="why-card-title">The View That Rewires You</h3>
          <p>3,700 meters on the Red Hill, Lhasa valley spreading below, Himalayan foothills on the horizon. Golden roofs catching afternoon sun, prayer flags snapping in thin air. You forget your phone exists.</p>
        </div>
      </div>
      <div class="why-card">
        <div class="why-card-media">
          <img src="/images/gallery-potala-golden-roofs.webp" alt="Potala Palace golden roofs glowing at sunset" loading="lazy" decoding="async" width="600" height="400" />
        </div>
        <div class="why-card-body">
          <h3 class="why-card-title">Architecture That Defies Belief</h3>
          <p>Thirteen stories, 1,000+ rooms, walls 3 meters thick at the base. Built at the elevation where airplanes pressurize their cabins — without cranes, without steel frames. Modern architects still study how it stands.</p>
        </div>
      </div>
      <div class="why-card">
        <div class="why-card-media">
          <img src="/images/gallery-potala-murals.webp" alt="Ancient Buddhist murals inside Potala Palace" loading="lazy" decoding="async" width="600" height="400" />
        </div>
        <div class="why-card-body">
          <h3 class="why-card-title">A Living Museum of Tibetan Buddhism</h3>
          <p>200,000 Buddhist statues, priceless thangkas, sutras handwritten in gold ink, gilded stupa tombs of eight Dalai Lamas. Monks still chant here. Butter lamps still burn. Incense hangs in corridors walked for 13 centuries.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PHOTO GALLERY -->
<section class="section">
  <div class="max-w-6xl mx-auto">
    <div class="section-header">
      <span class="section-tag">Visual Journey</span>
      <h2 class="section-title">Tibet in photographs</h2>
      <p style="color:var(--color-text-muted); margin-top:1rem; max-width:36rem;">From prayer wheels spinning in Barkhor Street to Himalayan peaks breaking through clouds — a visual tour of the Roof of the World.</p>
    </div>
  </div>
  <div class="gallery-slider-wrap" style="margin-top:2rem;">
    <PhotoGallery hideHeading={true} photos={[
      { src: "/images/gallery-potala-golden-roofs.webp", alt: "Potala Palace golden roofs at sunset", caption: "Golden roofs at sunset" },
      { src: "/images/tibetan-monks.webp", alt: "Tibetan monks in Lhasa", caption: "Monks in Lhasa" },
      { src: "/images/gallery-potala-water-reflection.webp", alt: "Potala Palace reflected in the water", caption: "Reflection at Dragon King Pond" },
      { src: "/images/jokhang-temple.webp", alt: "Jokhang Temple pilgrims", caption: "Jokhang Temple" },
      { src: "/images/gallery-potala-night.webp", alt: "Potala Palace illuminated at night", caption: "Palace lights after dark" },
      { src: "/images/prayer-wheels.webp", alt: "Prayer wheels in Tibet", caption: "Prayer wheels" },
      { src: "/images/himalaya-landscape.webp", alt: "Himalayan mountain landscape", caption: "Himalayan peaks" },
      { src: "/images/gallery-prayer-flags.webp", alt: "Prayer flags blowing in the Lhasa wind", caption: "Prayer flags" },
      { src: "/images/gallery-potala-murals.webp", alt: "Ancient Buddhist murals inside Potala Palace", caption: "Ancient murals" },
      { src: "/images/tibet-landscape.webp", alt: "Tibetan plateau landscape", caption: "The Plateau" },
    ]} />
  </div>
</section>

<!-- COST CALCULATOR -->
<section class="section" style="background:var(--color-surface-alt);">
  <div class="max-w-5xl mx-auto">

    <div class="calc-stats">
      <div class="calc-stat">
        <span class="calc-stat-icon">&#127902;</span>
        <span class="calc-stat-num">CNY 200</span>
        <span class="calc-stat-label">Peak Season <em>May – Oct</em></span>
      </div>
      <div class="calc-stat">
        <span class="calc-stat-icon">&#127903;</span>
        <span class="calc-stat-num">CNY 100</span>
        <span class="calc-stat-label">Off-Peak <em>Nov – Apr</em></span>
      </div>
      <div class="calc-stat">
        <span class="calc-stat-icon">&#128338;</span>
        <span class="calc-stat-num">9:30 – 15:30</span>
        <span class="calc-stat-label">Opening Hours <em>Last entry 15:30</em></span>
      </div>
      <div class="calc-stat">
        <span class="calc-stat-icon">&#128100;</span>
        <span class="calc-stat-num">2,300 / day</span>
        <span class="calc-stat-label">Visitor Cap <em>Reserve 5–7d ahead</em></span>
      </div>
    </div>

    <div class="cost-calc-card">
      <div class="cost-calc-header">
        <span class="section-tag">Interactive Tool</span>
        <h2 class="text-2xl font-[var(--font-display)] tracking-[-0.01em]">Visit Cost Calculator</h2>
        <p style="color:var(--color-text-muted); margin-top:0.5rem;">Estimate your total Potala Palace visit cost in 30 seconds.</p>
      </div>
      <div id="cost-calc">
        <div class="cost-step" id="cost-step-1">
          <p class="cost-step-label">How many adults?</p>
          <div class="cost-btn-group">
            <button class="cost-btn" data-value="1" onclick="selectCostBtn(this,1)"><span class="cost-btn-num">1</span><span class="cost-btn-text">person</span></button>
            <button class="cost-btn" data-value="2" onclick="selectCostBtn(this,1)"><span class="cost-btn-num">2</span><span class="cost-btn-text">people</span></button>
            <button class="cost-btn" data-value="3" onclick="selectCostBtn(this,1)"><span class="cost-btn-num">3+</span><span class="cost-btn-text">people</span></button>
          </div>
        </div>
        <div class="cost-step" id="cost-step-2" style="display:none">
          <p class="cost-step-label">Which season?</p>
          <div class="cost-btn-group">
            <button class="cost-btn" data-value="peak" onclick="selectCostBtn(this,2)"><span class="cost-btn-num">CNY 200</span><span class="cost-btn-text">Peak (May–Oct)</span></button>
            <button class="cost-btn" data-value="off" onclick="selectCostBtn(this,2)"><span class="cost-btn-num">CNY 100</span><span class="cost-btn-text">Off-peak (Nov–Apr)</span></button>
          </div>
        </div>
        <div class="cost-step" id="cost-step-3" style="display:none">
          <p class="cost-step-label">Add extras?</p>
          <div class="cost-extras">
            <label class="cost-check"><input type="checkbox" id="cost-guide"><span class="cost-check-body"><strong>English-speaking guide</strong><em>CNY 300 per group</em></span></label>
            <label class="cost-check"><input type="checkbox" id="cost-audio"><span class="cost-check-body"><strong>Audio guide rental</strong><em>CNY 30 per person</em></span></label>
            <label class="cost-check"><input type="checkbox" id="cost-photo"><span class="cost-check-body"><strong>Photography pass</strong><em>CNY 150</em></span></label>
          </div>
          <button class="cost-calc-btn" onclick="showCostResult()">Calculate total</button>
        </div>
        <div id="cost-result" style="display:none"></div>
      </div>
    </div>
  </div>
</section>

<!-- PLANNING TIMELINE -->
<section class="section">
  <div class="max-w-6xl mx-auto">
    <div class="section-header">
      <span class="section-tag">Planning Timeline</span>
      <h2 class="section-title">When to do what —<br/>8 weeks to departure</h2>
    </div>
    <div class="timeline-layout">
      <div class="timeline-image-col">
        <img src="/images/travel-planning.webp" alt="Travel planning" loading="lazy" decoding="async" />
        <img src="/images/passport-visa.webp" alt="Passport and visa" loading="lazy" decoding="async" class="timeline-img-2" />
      </div>
      <div class="timeline-col">
        <div class="timeline-box">
          <div class="timeline-steps">
            <div class="t-step"><div class="t-step-marker"><span>8</span></div><div class="t-step-body"><strong>8 weeks before</strong><p>Start Tibet Travel Permit application through a registered agency. Book international flights to China.</p></div></div>
            <div class="t-step"><div class="t-step-marker"><span>6</span></div><div class="t-step-body"><strong>6 weeks before</strong><p>Apply for Chinese tourist visa (L visa). Book Lhasa hotel with oxygen system for first 2 nights.</p></div></div>
        <div class="t-step"><div class="t-step-marker"><span>4</span></div><div class="t-step-body"><strong>4 weeks before</strong><p>Reserve Potala Palace tickets through your tour operator. Book flights or train to Lhasa. Consult doctor about altitude medication.</p></div></div>
        <div class="t-step"><div class="t-step-marker"><span>2</span></div><div class="t-step-body"><strong>2 weeks before</strong><p>Confirm all bookings. Pack using our checklist. Download offline maps and translation apps. Print all permits and tickets.</p></div></div>
        <div class="t-step"><div class="t-step-marker"><span>0</span></div><div class="t-step-body"><strong>Arrival day</strong><p>Rest and hydrate. No strenuous activity. Gentle walk on Barkhor Street. <a href="/visit" style="color:var(--color-accent); text-decoration:underline; text-underline-offset:2px;">Read the full visit guide</a>.</p></div></div>
      </div>
    </div>
      </div>
    </div>
  </div>
</section>

<!-- NAVIGATION GUIDES -->
