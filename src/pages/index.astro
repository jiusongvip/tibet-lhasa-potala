  }
  .cta-inner { max-width: 36rem; margin: 0 auto; }
  .cta-heading {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: 18px;
    color: white;
    font-family: var(--font-display);
  }
  .cta-sub {
    font-size: 0.9375rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.8;
    margin-bottom: 32px;
  }
  .cta-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    align-items: center;
  }
  .cta-actions .btn-primary {
    background: white;
    color: var(--color-text);
  }
  .cta-actions .btn-primary:hover { background: rgba(255,255,255,0.85); }
  .cta-secondary {
    color: rgba(255,255,255,0.5);
    font-size: 0.8125rem;
    text-decoration: none;
    border-bottom: 1px solid rgba(255,255,255,0.2);
    padding-bottom: 2px;
    transition: all 0.2s;
  }
  .cta-secondary:hover { color: white; border-color: rgba(255,255,255,0.5); }

  /* Culture Image Strip */
  .culture-image-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    max-width: 100%;
    margin: 0;
  }
  .culture-image-item {
    overflow: hidden;
  }
  .culture-image-item img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    display: block;
    transition: transform 0.6s;
  }
  .culture-image-item:hover img { transform: scale(1.05); }

  /* Guides Image Strip */
  .guides-image-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin-bottom: 40px;
  }
  .guides-image {
    position: relative;
    overflow: hidden;
  }
  .guides-image img {
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
    display: block;
    transition: transform 0.5s;
  }
  .guides-image:hover img { transform: scale(1.04); }
  .guides-image-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px;
    background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: white;
    font-family: var(--font-sans);
  }

  /* Hero CTA hover */
  .hero-cta:hover {
    border-color: rgba(255,255,255,0.8) !important;
    background: rgba(255,255,255,0.1);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .hero-badge { bottom: 60px; font-size: 0.625rem; padding: 5px 14px; }
    .timeline-layout { grid-template-columns: 1fr; gap: 1.5rem; }
    .timeline-image-col { flex-direction: row; }
    .timeline-image-col img { width: 48%; aspect-ratio: 1/1 !important; }
    .timeline-box { padding: 24px 20px; }
    .calc-stats { grid-template-columns: repeat(2, 1fr); }
    .why-grid { grid-template-columns: 1fr; gap: 24px; }
    .why-card-body { padding: 24px; }
    .cost-calc-card { padding: 24px 20px; }
    .altitude-tool { padding: 24px 20px; }
    .alt-step-opts { flex-direction: column; }
    .alt-btn { min-width: 0; }
    .testimonial-grid { grid-template-columns: 1fr; gap: 20px; }
    .testimonial-card { padding: 24px; }
    .nearby-grid { grid-template-columns: 1fr; }
    .nearby-card { padding: 24px; }
    .updates-box { padding: 24px; }
    .cta-actions { flex-direction: column; }
    .cost-result-actions { flex-direction: column; align-items: stretch; }
    .cost-result-amount { font-size: 2rem; }
    .guides-image-strip { grid-template-columns: 1fr; }
    .guides-image img { aspect-ratio: 16/7; }
    .culture-image-strip { grid-template-columns: 1fr; }
    .culture-image-item img { aspect-ratio: 16/9; }
