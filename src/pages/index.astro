  .alt-btn:hover { border-color: var(--color-text); }
  .alt-btn.selected { border-color: var(--color-text); background: var(--color-text); color: white; }

  /* Altitude Result */
  .alt-result-new { padding: 32px; margin-top: 28px; border: 1px solid var(--color-border); }
  .alt-result-good { background: #F6FAF6; border-color: #C8DBC8; }
  .alt-result-plan { background: #FDF7F0; border-color: #E8D5B0; }
  .alt-result-caution { background: #FDF5F5; border-color: #E8C8C8; }
  .alt-result-header { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
  .alt-result-icon { font-size: 1.5rem; }
  .alt-result-header h3 { font-size: 1.125rem; font-weight: 500; font-family: var(--font-display); margin: 0; }
  .alt-result-body { font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.7; }
  .alt-result-actions { display: flex; gap: 12px; margin-top: 22px; }

  /* Testimonials */
  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px;
    margin-top: 32px;
  }
  .testimonial-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
