<BaseLayout canonical="https://tibet-lhasa-potala.com" heroImage="/images/hero-potala-palace.webp" ogType="website" authorName="Potala Guide Editorial Team" authorUrl="/about" datePublished="2026-01-01" dateModified="2026-08-06"  title="Potala Palace Guide 2026 | Tickets, Permits & Tips"  description="Plan your Potala Palace visit: 2026 tickets, permits, photo spots, and altitude tips from local experts."  ogImage="https://tibet-lhasa-potala.com/images/og-potala-palace.webp">
