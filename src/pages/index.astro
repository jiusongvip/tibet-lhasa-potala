  /* Altitude Tool */
  .altitude-tool { background: var(--color-surface); border: 1px solid var(--color-border); padding: 36px 40px; }
  .altitude-tool-header { margin-bottom: 28px; }
  .altitude-steps { margin-top: 8px; }
  .alt-step { margin-top: 24px; }
  .alt-step:first-child { margin-top: 0; }
  .alt-step-q {
    font-size: 0.75rem;
