        <div class="cost-step" id="cost-step-2" style="display:none">
          <p class="cost-step-label">Which season?</p>
          <div class="cost-btn-group">
            <button class="cost-btn" data-value="peak" onclick="selectCostBtn(this,2)"><span class="cost-btn-num">CNY 200</span><span class="cost-btn-text">Peak (May Oct)</span></button>
            <button class="cost-btn" data-value="off" onclick="selectCostBtn(this,2)"><span class="cost-btn-num">CNY 100</span><span class="cost-btn-text">Off-peak (Nov Apr)</span></button>
          </div>
        </div>
        <div class="cost-step" id="cost-step-3" style="display:none">
          <p class="cost-step-label">Add extras?</p>
          <div class="cost-extras">
            <label class="cost-check"><input type="checkbox" id="cost-guide"><span class="cost-check-body"><strong>English-speaking guide</strong><em>CNY 300 per group</em></span></label>
            <label class="cost-check"><input type="checkbox" id="cost-audio"><span class="cost-check-body"><strong>Audio guide rental</strong><em>CNY 30 per person</em></span></label>
            <label class="cost-check"><input type="checkbox" id="cost-photo"><span class="cost-check-body"><strong>Photography pass</strong><em>CNY 150</em></span></label>
          </div>
          <button class="cost-calc-btn" onclick="showCostResult()">Calculate total</button>
        </div>
        <div id="cost-result" style="display:none"></div>
      </div>
    </div>
