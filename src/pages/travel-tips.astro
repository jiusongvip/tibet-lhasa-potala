---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PageNav from "../components/PageNav.astro";
import StructuredData from "../components/StructuredData.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import AuthorBio from "../components/AuthorBio.astro";

const faqs = [
  { q: "How bad is altitude sickness in Lhasa?", a: "At 3,650m, altitude affects most visitors to some degree. Symptoms: headache, fatigue, shortness of breath, nausea, and disturbed sleep. Most people adapt within 24-48 hours. The key rules: ascend gradually, rest completely on day one, drink 3-4 liters of water daily, and avoid alcohol for the first 48 hours." },
  { q: "What medication should I bring?", a: "Diamox (acetazolamide) for altitude prevention -- start 24 hours before ascending. Ibuprofen for headaches. Bring personal prescriptions plus: SPF 50+ sunscreen, lip balm with SPF, hand sanitizer, rehydration salts, anti-diarrheal medication, and basic first aid supplies. Lhasa pharmacies have limited English-language products." },
  { q: "What should I pack?", a: "Layers are everything: warm jacket (even in summer), thermal base layers, comfortable walking shoes with good grip, sun hat, UV-protective sunglasses (category 3-4), high-SPF sunscreen, reusable water bottle, small day pack for sightseeing, power bank (cold drains batteries faster), and printed copies of all permits." },
  { q: "Do I need travel insurance?", a: "Strongly recommended. At minimum, ensure your policy covers high-altitude trekking (above 3,000m), emergency medical evacuation, and trip cancellation. Standard travel insurance often excludes activities above 2,500-3,000m -- check the fine print carefully." },
];
---

<BaseLayout canonical="https://www.tibet-lhasa-potala.com/travel-tips" title="Tibet Travel Tips 2026 | Altitude, Packing, Health & Insurance" description="Essential Tibet travel tips: altitude sickness prevention and treatment, complete packing list, health advice, travel insurance guide, and safety tips for Lhasa." ogImage="https://www.tibet-lhasa-potala.com/images/og-potala-palace.webp" authorName="Sarah Chen" authorUrl="/about/#sarah-chen" datePublished="2026-01-20" dateModified="2026-08-06">`n<StructuredData type="Article" data={{ title: "Tibet Travel Tips", description: "Altitude, packing, health, and safety tips for traveling to Tibet and visiting Potala Palace.", url: "/travel-tips/", datePublished: "2026-01-01", dateModified: "2026-08-06" }} />
  <StructuredData type="BreadcrumbList" data={{ items: [{ name: "Home", url: "/" }, { name: "Travel Tips", url: "/travel-tips/" }] }} />
  <StructuredData type="FAQPage" data={{ faqs }} />
  <StructuredData type="Person" data={{ name: "Sarah Chen", description: "Senior Travel Writer & Tibet Specialist, Wilderness First Responder certified.", url: "/about/#sarah-chen" }} />

  <PageHero title="Tibet Travel Tips" subtitle="Altitude survival, complete packing list, health and safety advice, travel insurance guide, and everything you need to prepare for Lhasa." breadcrumb="Travel Tips" updated="August 2026" image="/images/himalaya-landscape.webp" />

  <!-- Stats Bar -->
  <div class="max-w-5xl mx-auto px-4 md:px-6 pt-4">
    <div class="stats-bar">
      <div class="stat-item">
        <span class="stat-number">3,650m</span>
        <span class="stat-label">Lhasa Elevation</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">40%</span>
        <span class="stat-label">Less Oxygen</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">12+</span>
        <span class="stat-label">Max UV Index</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">3&ndash;4 L</span>
        <span class="stat-label">Daily Water</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">24&ndash;72h</span>
        <span class="stat-label">Acclimatization</span>
      </div>
    </div>
  </div>

  <!-- Altitude Section with Severity Cards -->
  <section class="max-w-5xl mx-auto px-4 md:px-6 py-14">
    <h2 id="altitude" class="section-title mb-3">Altitude: The Science &amp; Survival Guide</h2>
    <p class="section-subtitle">At 3,650 meters the air contains approximately 40% less oxygen than at sea level. Your body needs time to adapt &mdash; a process called acclimatization that takes 24&ndash;72 hours.</p>

    <div class="altitude-severity-grid">
      <div class="severity-card sev-mild">
        <div class="sev-head">
          <span class="sev-dot"></span>
          <h3>Normal Symptoms</h3>
          <span class="sev-tag">Expected</span>
        </div>
        <p>Mild headache, fatigue after minimal exertion, shortness of breath when walking uphill or climbing stairs, disrupted sleep, reduced appetite. These are normal and not dangerous in themselves.</p>
        <div class="sev-symptoms">
          <span>Headache</span>
          <span>Fatigue</span>
          <span>Breathlessness</span>
          <span>Poor Sleep</span>
          <span>Low Appetite</span>
        </div>
      </div>
      <div class="severity-card sev-severe">
        <div class="sev-head">
          <span class="sev-dot"></span>
          <h3>Warning Signs</h3>
          <span class="sev-tag sev-tag-danger">Emergency</span>
        </div>
        <p>Severe headache unresponsive to painkillers, confusion or difficulty walking straight, persistent dry cough with pink/frothy sputum, extreme shortness of breath at rest. These may indicate HACE or HAPE &mdash; life-threatening emergencies.</p>
        <div class="sev-symptoms sev-symptoms-danger">
          <span>Severe Headache</span>
          <span>Confusion</span>
          <span>Pink Sputum</span>
          <span>Rest Dyspnea</span>
        </div>
        <div class="sev-action">Descend immediately and seek medical help</div>
      </div>
    </div>

    <h3 class="acclim-title">The Acclimatization Strategy</h3>
    <div class="acclim-steps">
      <div class="acclim-step">
        <span class="step-num">1</span>
        <div>
          <strong>Fly to a lower city first</strong>
          <p>Spend 2&ndash;3 days in Chengdu (500m), Xi'an (400m), or Kunming (1,900m) before flying to Lhasa. This partial acclimatization makes a significant difference.</p>
        </div>
      </div>
      <div class="acclim-step">
        <span class="step-num">2</span>
        <div>
          <strong>Take the train</strong>
          <p>The Qinghai-Tibet Railway from Xining (2,275m) takes ~21 hours. The gradual ascent and pressurized, oxygen-enriched train cars help your body adjust.</p>
        </div>
      </div>
      <div class="acclim-step">
        <span class="step-num">3</span>
        <div>
          <strong>Rest completely on arrival day</strong>
          <p>No sightseeing. Don't even walk around aggressively. Lie down, drink water, eat lightly, and let your body do its work.</p>
        </div>
      </div>
      <div class="acclim-step">
        <span class="step-num">4</span>
        <div>
          <strong>Hydrate relentlessly</strong>
          <p>At altitude you lose water through increased respiration and dry air. Aim for 3&ndash;4 liters per day. Your urine should be clear or pale yellow.</p>
        </div>
      </div>
      <div class="acclim-step">
        <span class="step-num">5</span>
        <div>
          <strong>Avoid alcohol and sedatives</strong>
          <p>Both depress your respiratory drive &mdash; the last thing you want when your body is starved for oxygen. Avoid for at least 48 hours.</p>
        </div>
      </div>
      <div class="acclim-step">
        <span class="step-num">6</span>
        <div>
          <strong>Climb high, sleep low</strong>
          <p>If visiting higher areas outside Lhasa, return to a lower elevation to sleep whenever possible.</p>
        </div>
      </div>
    </div>

    <!-- Medication Cards -->
    <h3 class="acclim-title">Altitude Medication</h3>
    <div class="med-grid">
      <div class="med-card">
        <h4>Acetazolamide <small>(Diamox)</small></h4>
        <p>The most proven altitude sickness prevention. Acidifies your blood, stimulating breathing. Start 125&ndash;250mg twice daily, 24 hours before ascending. Side effects: tingling in fingers/toes, increased urination (both normal).</p>
      </div>
      <div class="med-card">
        <h4>Ibuprofen</h4>
        <p>Effective for altitude headaches. Take 400mg as needed. Bring enough for your entire trip &mdash; Lhasa pharmacies have limited English-language products.</p>
      </div>
      <div class="med-card">
        <h4>Dexamethasone</h4>
        <p>A powerful steroid for treating severe altitude sickness. Requires a prescription. Discuss with your doctor before travel. For emergency use only, not prevention.</p>
      </div>
    </div>
  </section>

  <!-- Packing Checklist Grid -->
  <section class="packing-section">
    <div class="max-w-5xl mx-auto px-4 md:px-6 py-14">
      <h2 class="section-title mb-3">Complete Packing List</h2>
      <p class="section-subtitle">Layers are everything at altitude. Here's everything you need, organized by category.</p>

      <div class="packing-grid">
        <div class="packing-category">
          <div class="packing-cat-head">
            <span class="packing-cat-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
            </span>
            <h3>Clothing &mdash; Layers Are Everything</h3>
          </div>
          <ul>
            <li><span>Warm insulated jacket</span> <small>Down or synthetic, rated to -5 C (spring/autumn) or -20 C (winter)</small></li>
            <li><span>Thermal base layers</span> <small>Merino wool preferred &mdash; no cotton</small></li>
            <li><span>Mid-layer fleece or wool sweater</span></li>
            <li><span>Comfortable walking shoes</span> <small>Good grip &mdash; Potala steps are uneven stone</small></li>
            <li><span>Warm socks</span> <small>2&ndash;3 pairs wool or synthetic</small></li>
            <li><span>Sun hat with brim</span></li>
            <li><span>Warm beanie</span> <small>For evenings and early mornings</small></li>
            <li><span>Light gloves</span> <small>Even in summer, mornings are cold</small></li>
          </ul>
        </div>
        <div class="packing-category">
          <div class="packing-cat-head">
            <span class="packing-cat-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </span>
            <h3>Sun &amp; Health Protection</h3>
          </div>
          <ul>
            <li><span>SPF 50+ broad-spectrum sunscreen</span> <small>UV index at 3,700m can exceed 12 in summer</small></li>
            <li><span>UV-protective sunglasses</span> <small>Category 3 or 4 &mdash; glare off white palace walls is intense</small></li>
            <li><span>SPF 30+ lip balm</span></li>
            <li><span>Personal medications</span> <small>Plus prescription copies</small></li>
            <li><span>Basic first aid</span> <small>Band-aids, antiseptic wipes, blister pads, anti-diarrheal medication</small></li>
          </ul>
        </div>
        <div class="packing-category">
          <div class="packing-cat-head">
            <span class="packing-cat-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </span>
            <h3>Documents &amp; Essentials</h3>
          </div>
          <ul>
            <li><span>Passport</span> <small>6+ months validity</small></li>
            <li><span>Tibet Travel Permit copies</span> <small>At least 3 printed copies plus your Chinese visa</small></li>
            <li><span>Travel insurance documents</span> <small>With emergency contact numbers</small></li>
            <li><span>Cash in RMB</span> <small>ATMs available in Lhasa but less reliable outside center</small></li>
            <li><span>Power bank</span> <small>Phone batteries drain faster in cold</small></li>
            <li><span>Reusable water bottle</span> <small>1L minimum</small></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Health Advice Cards -->
  <section class="max-w-5xl mx-auto px-4 md:px-6 pb-14">
    <h2 class="section-title mb-3">Health &amp; Safety in Lhasa</h2>
    <p class="section-subtitle">Lhasa is generally safe. Violent crime is rare. The main health concern is altitude.</p>
    <div class="health-grid">
      <div class="health-card">
        <h4>Water</h4>
        <p>Bottled water only. Available everywhere for CNY 2&ndash;3. Most hotels provide a kettle &mdash; boil for 3+ minutes at this altitude.</p>
      </div>
      <div class="health-card">
        <h4>Food Safety</h4>
        <p>Tibetan food is generally safe. Be cautious with street food that has been sitting out. Wash hands frequently.</p>
      </div>
      <div class="health-card">
        <h4>Hospital</h4>
        <p>Lhasa People's Hospital has basic facilities. For serious conditions, evacuation to Chengdu or Beijing is necessary. This is why insurance matters.</p>
      </div>
    </div>
  </section>

  <!-- Insurance Tips -->
  <section class="insurance-section">
    <div class="max-w-5xl mx-auto px-4 md:px-6 py-14">
      <h2 class="section-title mb-3">Travel Insurance: Read the Fine Print</h2>
      <p class="section-subtitle">This is not optional for Tibet. Standard policies often exclude coverage above 2,500&ndash;3,000 meters.</p>
      <div class="insurance-checklist">
        <div class="ins-check">
          <span class="ins-check-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <div>
            <strong>Covers travel above 3,700 meters</strong>
            <p>Explicitly stated in the policy, not implied. This is the single most common exclusion that invalidates coverage.</p>
          </div>
        </div>
        <div class="ins-check">
          <span class="ins-check-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <div>
            <strong>Includes emergency medical evacuation</strong>
            <p>Helicopter evacuation from remote areas of Tibet can cost USD 15,000&ndash;50,000. Make sure this is covered.</p>
          </div>
        </div>
        <div class="ins-check">
          <span class="ins-check-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <div>
            <strong>Covers trip cancellation</strong>
            <p>Including permit denial (rare but possible). Ensure the policy covers this specific scenario.</p>
          </div>
        </div>
        <div class="ins-check">
          <span class="ins-check-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <div>
            <strong>Covers pre-existing conditions</strong>
            <p>If relevant to you. Be honest in your declaration &mdash; undisclosed conditions will void coverage.</p>
          </div>
        </div>
      </div>
      <div class="ins-providers">
        <p><strong>Reputable providers:</strong> World Nomads (Explorer plan), IMG Global, and Allianz (with adventure sports add-on). Check current policies as offerings change annually.</p>
      </div>
    </div>
  </section>

  <!-- Image Break -->
  <div class="image-break">
    <img src="/images/yak-himalaya.webp" alt="Yaks grazing on the Himalayan plateau with snow-capped mountains in the distance" loading="lazy" width="1200" height="600" />
    <div class="image-break-caption">The Tibetan Plateau at altitude &mdash; beautiful, vast, and demanding of respect</div>
  </div>

  <!-- Cultural Dos and Don'ts -->
  <section class="max-w-5xl mx-auto px-4 md:px-6 py-14">
    <h2 class="section-title mb-3">Cultural Etiquette in Tibet</h2>
    <p class="section-subtitle">Tibetan culture is warm, deeply religious, and governed by specific customs that visitors should respect.</p>

    <div class="culture-grid">
      <div class="culture-card culture-do">
        <div class="culture-card-head">
          <span class="culture-tag culture-tag-do">Do</span>
        </div>
        <p><strong>Walk clockwise</strong> around sacred objects, prayer wheels, monasteries, and circumambulation paths like Barkhor. This is the direction of spiritual merit.</p>
      </div>
      <div class="culture-card culture-dont">
        <div class="culture-card-head">
          <span class="culture-tag culture-tag-dont">Don't</span>
        </div>
        <p><strong>Point at religious objects</strong> &mdash; Buddha statues, thangkas, or monks. Use an open palm with all fingers extended, gesturing upward instead.</p>
      </div>
      <div class="culture-card culture-do">
        <div class="culture-card-head">
          <span class="culture-tag culture-tag-do">Do</span>
        </div>
        <p><strong>Ask before photographing</strong> people, especially older pilgrims and monks. A small offering (CNY 5&ndash;10) is appropriate if someone agrees.</p>
      </div>
      <div class="culture-card culture-dont">
        <div class="culture-card-head">
          <span class="culture-tag culture-tag-dont">Don't</span>
        </div>
        <p><strong>Step on thresholds</strong> when entering temples or chapels. Step over the wooden threshold &mdash; it's the boundary between secular and sacred worlds.</p>
      </div>
      <div class="culture-card culture-do">
        <div class="culture-card-head">
          <span class="culture-tag culture-tag-do">Do</span>
        </div>
        <p><strong>Dress modestly</strong> in monasteries. Shoulders and knees covered. Remove hats before entering chapels. These rules are enforced at Potala, Jokhang, and all monasteries.</p>
      </div>
      <div class="culture-card culture-dont">
        <div class="culture-card-head">
          <span class="culture-tag culture-tag-dont">Don't</span>
        </div>
        <p><strong>Touch a monk's robes</strong> or prayer beads. These are sacred items. Even accidental contact can cause offense.</p>
      </div>
    </div>

    <div class="culture-warning">
      <strong>Political sensitivity:</strong> Avoid discussing Tibetan political issues, displaying images of the Dalai Lama, or making political statements. Such actions can result in deportation and a travel ban from China.
    </div>
  </section>

  <!-- SIM Cards + Connectivity -->
  <section class="max-w-5xl mx-auto px-4 md:px-6 pb-14">
    <h2 class="section-title mb-3">Money, SIM Cards &amp; Staying Connected</h2>
    <div class="connect-grid">
      <div class="connect-card">
        <h3>Currency &amp; Payments</h3>
        <p>China uses Renminbi (RMB/CNY). Cash is still widely used at small restaurants, market stalls, and monastery entrances. ATMs accepting foreign cards are available at the Bank of China on Beijing East Road and near Barkhor &mdash; but they occasionally run out of cash. Carry enough for 2&ndash;3 days.</p>
        <p>Mobile payments (WeChat Pay, Alipay) dominate. Foreign visitors can now link international credit cards &mdash; set this up before arriving. Many small vendors only accept mobile payments.</p>
      </div>
      <div class="connect-card">
        <h3>SIM Cards &amp; Internet</h3>
        <p>A local China Mobile or China Unicom SIM costs CNY 50&ndash;100 with a data plan. Passport required. Major carrier shops are on Beijing East Road.</p>
        <p><strong>Set up a VPN before arriving.</strong> Google, WhatsApp, Instagram, Gmail, and many international sites are blocked without one. Test your VPN before you leave home &mdash; some stop working inside China.</p>
      </div>
      <div class="connect-card">
        <h3>WiFi</h3>
        <p>Most mid-range and luxury hotels offer WiFi, but speeds vary and international sites are blocked without a VPN. Download offline maps (Maps.me or Google Maps offline), translation apps, and reference materials before arriving. Don't rely on hotel WiFi for anything critical.</p>
      </div>
    </div>
  </section>

  <!-- Image Break 2 -->
  <div class="image-break">
    <img src="/images/tibetan-architecture.webp" alt="Traditional Tibetan architecture in Lhasa with ornate details and prayer flags" loading="lazy" width="1200" height="600" />
    <div class="image-break-caption">Traditional Tibetan architecture &mdash; centuries of craftsmanship in stone, wood, and color</div>
  </div>

  <!-- Pull Quote -->
  <section class="max-w-3xl mx-auto px-4 md:px-6 py-12">
    <blockquote class="pull-quote">
      <p>Preparation transforms a trip to Tibet from an endurance test into the journey of a lifetime. Respect the altitude, pack smart, insure properly, and the plateau will reward you in ways you cannot imagine.</p>
      <cite>&mdash; Travelers who prepared well for Tibet</cite>
    </blockquote>
  </section>

  <section class="max-w-3xl mx-auto px-4 md:px-6 pb-12">
    <h2 class="text-2xl font-bold mb-6">Common Travel Questions</h2>
    
  <section class="max-w-3xl mx-auto px-4 md:px-6 py-8">
    <AuthorBio slug="sarah-chen" datePublished="2026-01-20" dateModified="2026-08-06" />
  </section>

  <section class="max-w-3xl mx-auto px-4 md:px-6 py-8">
    <div class="altitude-tool">
      <div class="altitude-tool-header">
        <span class="section-tag">Interactive Tool</span>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-text)]">Packing List Generator</h2>
        <p class="text-[var(--color-text-muted)] mt-1">Select your travel season, trip length, and activities to get a customized packing checklist.</p>
      </div>
      <div id="packing-check">
        <div class="alt-step" id="pack-step-1">
          <p class="alt-step-q">When are you traveling?</p>
          <div class="alt-step-opts">
            <button class="alt-btn" data-value="winter" onclick="selectPack(this,1)">Winter (Nov-Feb)</button>
            <button class="alt-btn" data-value="shoulder" onclick="selectPack(this,1)">Shoulder (Mar-Apr, Oct)</button>
            <button class="alt-btn" data-value="summer" onclick="selectPack(this,1)">Summer (May-Sep)</button>
          </div>
        </div>
        <div class="alt-step" id="pack-step-2" style="display:none">
          <p class="alt-step-q">How many days is your trip?</p>
          <div class="alt-step-opts">
            <button class="alt-btn" data-value="3" onclick="selectPack(this,2)">3-4 days (Lhasa only)</button>
            <button class="alt-btn" data-value="7" onclick="selectPack(this,2)">5-7 days (Lhasa + day trips)</button>
            <button class="alt-btn" data-value="10" onclick="selectPack(this,2)">8+ days (extended Tibet)</button>
          </div>
        </div>
        <div class="alt-step" id="pack-step-3" style="display:none">
          <p class="alt-step-q">What activities are you planning?</p>
          <div class="alt-step-opts">
            <button class="alt-btn" data-value="cultural" onclick="selectPack(this,3)">Cultural sightseeing</button>
            <button class="alt-btn" data-value="photo" onclick="selectPack(this,3)">Photography focused</button>
            <button class="alt-btn" data-value="trek" onclick="selectPack(this,3)">Hiking / trekking</button>
          </div>
        </div>
        <div id="pack-result" style="display:none"></div>
      </div>
    </div>
  </section>
  <script is:inline>
    const packAnswers = {};
    function selectPack(el, step) {
      const stepDiv = document.getElementById('pack-step-' + step);
      stepDiv.querySelectorAll('.alt-btn').forEach(b => b.classList.remove('selected'));
      el.classList.add('selected');
      packAnswers[step] = el.dataset.value;
      setTimeout(() => {
        stepDiv.style.display = 'none';
        if (step < 3) {
          document.getElementById('pack-step-' + (step + 1)).style.display = 'block';
        } else {
          showPackResult();
        }
      }, 200);
    }
    function showPackResult() {
      const result = document.getElementById('pack-result');
      const items = [];

      // Base layer - always needed
      items.push('<h3 class="text-lg font-semibold text-[var(--color-text)] mb-2">Clothing & Layers</h3>');
      items.push('<ul class="list-disc pl-5 mb-3 text-sm text-[var(--color-text-muted)]">');
      items.push('<li>Thermal base layer (top + bottom)</li>');
      items.push('<li>Fleece or wool mid-layer</li>');
      if (packAnswers[1] === 'winter') {
        items.push('<li>Heavy down jacket (rated to -20 C)</li>');
        items.push('<li>Insulated snow pants</li>');
      } else if (packAnswers[1] === 'shoulder') {
        items.push('<li>Light down jacket or insulated vest</li>');
        items.push('<li>Waterproof shell jacket</li>');
      } else {
        items.push('<li>Lightweight fleece or hoodie</li>');
        items.push('<li>Waterproof windbreaker</li>');
      }
      items.push('<li>Comfortable walking pants (2 pairs)</li>');
      items.push('<li>Warm socks (3-4 pairs, wool preferred)</li>');
      items.push('</ul>');

      // Footwear
      items.push('<h3 class="text-lg font-semibold text-[var(--color-text)] mb-2">Footwear</h3>');
      items.push('<ul class="list-disc pl-5 mb-3 text-sm text-[var(--color-text-muted)]">');
      if (packAnswers[3] === 'trek') {
        items.push('<li>Waterproof hiking boots (broken in before trip)</li>');
        items.push('<li>Camp shoes or sandals for evenings</li>');
      } else {
        items.push('<li>Comfortable walking shoes with good grip</li>');
      }
      items.push('</ul>');

      // Sun protection
      items.push('<h3 class="text-lg font-semibold text-[var(--color-text)] mb-2">Sun Protection (critical at 3,700m)</h3>');
      items.push('<ul class="list-disc pl-5 mb-3 text-sm text-[var(--color-text-muted)]">');
      items.push('<li>SPF 50+ sunscreen</li>');
      items.push('<li>Lip balm with SPF</li>');
      items.push('<li>Wide-brimmed hat</li>');
      items.push('<li>UV-protective sunglasses (category 3 or 4)</li>');
      items.push('</ul>');

      // Health & altitude
      items.push('<h3 class="text-lg font-semibold text-[var(--color-text)] mb-2">Health & Altitude</h3>');
      items.push('<ul class="list-disc pl-5 mb-3 text-sm text-[var(--color-text-muted)]">');
      items.push('<li>Ibuprofen or paracetamol for headaches</li>');
      items.push('<li>Diamox (acetazolamide) — consult your doctor</li>');
      items.push('<li>Rehydration salts or electrolyte tablets</li>');
      items.push('<li>Personal prescription medications</li>');
      if (packAnswers[3] === 'trek') {
        items.push('<li>Blister kit (moleskin, antiseptic)</li>');
        items.push('<li>Basic first-aid kit</li>');
      }
      items.push('</ul>');

      // Extras based on days
      items.push('<h3 class="text-lg font-semibold text-[var(--color-text)] mb-2">Quantity Guide</h3>');
      items.push('<ul class="list-disc pl-5 mb-3 text-sm text-[var(--color-text-muted)]">');
      const days = parseInt(packAnswers[2] || '3');
      items.push('<li>Underwear: ' + (days + 2) + ' pairs</li>');
      items.push('<li>Socks: ' + (days + 1) + ' pairs</li>');
      items.push('<li>T-shirts/shirts: ' + Math.ceil(days/2) + ' (plan to re-wear layers)</li>');
      items.push('</ul>');

      // Photography extras
      if (packAnswers[3] === 'photo') {
        items.push('<h3 class="text-lg font-semibold text-[var(--color-text)] mb-2">Photography Gear</h3>');
        items.push('<ul class="list-disc pl-5 mb-3 text-sm text-[var(--color-text-muted)]">');
        items.push('<li>Extra memory cards (at least 2)</li>');
        items.push('<li>Spare batteries (cold drains them fast)</li>');
        items.push('<li>Lens cleaning cloth</li>');
        items.push('<li>Tripod (lightweight, check drone regulations)</li>');
        items.push('</ul>');
      }

      // Always
      items.push('<h3 class="text-lg font-semibold text-[var(--color-text)] mb-2">Always Bring</h3>');
      items.push('<ul class="list-disc pl-5 mb-3 text-sm text-[var(--color-text-muted)]">');
      items.push('<li>Reusable water bottle (at least 1L)</li>');
      items.push('<li>Passport + printed copies of Tibet Travel Permit</li>');
      items.push('<li>Power bank (20,000 mAh minimum)</li>');
      items.push('<li>Universal travel adapter</li>');
      items.push('<li>Tissues and wet wipes (public toilets rarely have toilet paper)</li>');
      items.push('<li>Hand sanitizer</li>');
      items.push('<li>Snacks from home (granola bars, nuts, chocolate)</li>');
      items.push('</ul>');

      result.innerHTML = '<div class="alt-result-box border-l-emerald-500">' + items.join('') + '<button class="alt-btn text-sm inline-block w-auto mr-3 mt-2" onclick="resetPack()">Start over</button><a href="/travel-tips/" class="btn-primary text-sm inline-flex">Full travel tips</a></div>';
      result.style.display = 'block';
    }
    function resetPack() {
      Object.keys(packAnswers).forEach(k => delete packAnswers[k]);
      document.querySelectorAll('#packing-check .alt-btn').forEach(b => b.classList.remove('selected'));
      document.getElementById('pack-step-1').style.display = 'block';
      document.getElementById('pack-step-2').style.display = 'none';
      document.getElementById('pack-step-3').style.display = 'none';
      document.getElementById('pack-result').style.display = 'none';
    }
  </script>


