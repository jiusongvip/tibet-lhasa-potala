---
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  heroImage?: string;
  ogType?: string;
  authorName?: string;
  authorUrl?: string;
  datePublished?: string;
  dateModified?: string;
  noindex?: boolean;
}
const { title, description, ogImage, canonical, heroImage, ogType, authorName, authorUrl, datePublished, dateModified, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6QBWPLKQNF"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-6QBWPLKQNF');
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    {!noindex && canonical && <link rel="canonical" href={canonical} />}
    {!noindex && canonical && <link rel="alternate" hreflang="en" href={canonical} />}
    {!noindex && canonical && <link rel="alternate" hreflang="x-default" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogType ? <meta property="og:type" content={ogType} /> : authorName && datePublished ? <meta property="og:type" content="article" /> : <meta property="og:type" content="website" />}
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    {authorName && <meta name="author" content={authorName} />}
    {authorName && <meta property="article:author" content={authorName} />}
    {datePublished && <meta property="article:published_time" content={datePublished} />}
    {dateModified && <meta property="article:modified_time" content={dateModified} />}
    {authorName && authorUrl && <link rel="author" href={authorUrl} />}
    {heroImage && <link rel="preload" as="image" href={heroImage} fetchpriority="high" crossorigin="anonymous" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="min-h-[100dvh] flex flex-col">
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="sticky top-0 z-50 bg-[#F9F8F6]/95 backdrop-blur-sm border-b border-[var(--color-border)]">
      <nav class="max-w-[1440px] mx-auto px-6 md:px-10 h-[66px] flex items-center justify-between" aria-label="Main navigation">
        <a href="/" class="font-[var(--font-display)] font-semibold text-xl tracking-tight text-[var(--color-text)] no-underline">
          Potala Guide
        </a>
        <div class="hidden md:flex items-center gap-8">
          <a href="/visit/" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors no-underline tracking-[0.02em]">Visit</a>
          <a href="/permits/" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors no-underline tracking-[0.02em]">Permits</a>
          <a href="/history/" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors no-underline tracking-[0.02em]">History</a>
          <a href="/photography/" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors no-underline tracking-[0.02em]">Photos</a>
          <a href="/lhasa-food/" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors no-underline tracking-[0.02em]">Food</a>
          <a href="/hotels-potala-view/" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors no-underline tracking-[0.02em]">Hotels</a>
          <a href="/lhasa-transport/" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors no-underline tracking-[0.02em]">Transport</a>
          <a href="/travel-tips/" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors no-underline tracking-[0.02em]">Tips</a>
        </div>
        <button id="menu-toggle" class="md:hidden p-2 -mr-2 text-[var(--color-text)]" aria-label="Toggle menu" aria-expanded="false">
          <svg aria-hidden="true" class="menu-icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          <svg aria-hidden="true" class="menu-icon-close hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </nav>
      <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--color-border)] bg-[#F9F8F6]">
        <div class="px-6 py-6 flex flex-col gap-1">
          <a href="/visit/" class="text-[var(--color-text)] text-sm py-3 no-underline border-b border-[var(--color-border)]/50">Visit Guide</a>
          <a href="/permits/" class="text-[var(--color-text)] text-sm py-3 no-underline border-b border-[var(--color-border)]/50">Travel Permits</a>
          <a href="/history/" class="text-[var(--color-text)] text-sm py-3 no-underline border-b border-[var(--color-border)]/50">History</a>
          <a href="/photography/" class="text-[var(--color-text)] text-sm py-3 no-underline border-b border-[var(--color-border)]/50">Photography</a>
          <a href="/travel-tips/" class="text-[var(--color-text)] text-sm py-3 no-underline border-b border-[var(--color-border)]/50">Travel Tips</a>
          <a href="/lhasa-3-day-itinerary/" class="text-[var(--color-text)] text-sm py-3 no-underline border-b border-[var(--color-border)]/50">3-Day Itinerary</a>
          <a href="/tibet-etiquette/" class="text-[var(--color-text)] text-sm py-3 no-underline border-b border-[var(--color-border)]/50">Etiquette</a>
          <a href="/lhasa-with-kids/" class="text-[var(--color-text)] text-sm py-3 no-underline border-b border-[var(--color-border)]/50">With Kids</a>
          <a href="/lhasa-vegetarian-halal/" class="text-[var(--color-text)] text-sm py-3 no-underline border-b border-[var(--color-border)]/50">Vegetarian & Halal</a>
          <a href="/best-time/" class="text-[var(--color-text)] text-sm py-3 no-underline border-b border-[var(--color-border)]/50">Best Time</a>
          <a href="/lhasa-attractions/" class="text-[var(--color-text)] text-sm py-3 no-underline border-b border-[var(--color-border)]/50">Attractions</a>
          <a href="/lhasa-food/" class="text-[var(--color-text)] text-sm py-3 no-underline border-b border-[var(--color-border)]/50">Food Guide</a>
          <a href="/hotels-potala-view/" class="text-[var(--color-text)] text-sm py-3 no-underline border-b border-[var(--color-border)]/50">Potala View Hotels</a>
          <a href="/lhasa-transport/" class="text-[var(--color-text)] text-sm py-3 no-underline">Transport</a>
        </div>
      </div>
    </header>

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <footer class="bg-[var(--color-text)] text-white/60 py-16 px-6 md:px-10">
      <div class="max-w-[1440px] mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-5 gap-8 mb-12">
          <div class="col-span-2 md:col-span-1">
            <p class="font-[var(--font-display)] text-white font-semibold text-xl mb-3">Potala Guide</p>
            <p class="text-sm leading-relaxed text-white/40">Your complete guide to Potala Palace, Lhasa, Tibet. Updated for 2026.</p>
            <a href="/about/" class="inline-block mt-4 text-xs text-white/50 hover:text-white/80 transition-colors border-b border-white/20 hover:border-white/50">About us</a>
          </div>
          <div>
            <p class="font-semibold text-[0.6875rem] text-white/35 uppercase tracking-[0.1em] mb-4 font-[var(--font-sans)]">Essential</p>
            <a href="/visit/" class="block text-sm text-white/50 hover:text-white transition-colors no-underline py-1">Visit Guide</a>
            <a href="/permits/" class="block text-sm text-white/50 hover:text-white transition-colors no-underline py-1">Travel Permits</a>
            <a href="/best-time/" class="block text-sm text-white/50 hover:text-white transition-colors no-underline py-1">Best Time</a>
          </div>
          <div>
            <p class="font-semibold text-[0.6875rem] text-white/35 uppercase tracking-[0.1em] mb-4 font-[var(--font-sans)]">Explore</p>
            <a href="/history/" class="block text-sm text-white/50 hover:text-white transition-colors no-underline py-1">History</a>
            <a href="/photography/" class="block text-sm text-white/50 hover:text-white transition-colors no-underline py-1">Photography</a>
            <a href="/lhasa-attractions/" class="block text-sm text-white/50 hover:text-white transition-colors no-underline py-1">Attractions</a>
          </div>
          <div>
            <p class="font-semibold text-[0.6875rem] text-white/35 uppercase tracking-[0.1em] mb-4 font-[var(--font-sans)]">Plan</p>
            <a href="/lhasa-food/" class="block text-sm text-white/50 hover:text-white transition-colors no-underline py-1">Food Guide</a>
            <a href="/hotels-potala-view/" class="block text-sm text-white/50 hover:text-white transition-colors no-underline py-1">Hotels</a>
            <a href="/lhasa-transport/" class="block text-sm text-white/50 hover:text-white transition-colors no-underline py-1">Transport</a>
          </div>
          <div>
            <p class="font-semibold text-[0.6875rem] text-white/35 uppercase tracking-[0.1em] mb-4 font-[var(--font-sans)]">Prepare</p>
            <a href="/travel-tips/" class="block text-sm text-white/50 hover:text-white transition-colors no-underline py-1">Travel Tips</a>
            <a href="/travel-tips#altitude" class="block text-sm text-white/50 hover:text-white transition-colors no-underline py-1">Altitude Advice</a>
          </div>
        </div>
        <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
          <p class="text-xs text-white/30">
            &copy; 2026 Potala Guide &middot; Not affiliated with official tourism authorities.
          </p>
          <div class="flex items-center gap-6 text-xs">
            <a href="/privacy/" class="text-white/35 hover:text-white/60 transition-colors no-underline">Privacy</a>
            <a href="/terms/" class="text-white/35 hover:text-white/60 transition-colors no-underline">Terms</a>
            <a href="/about/" class="text-white/35 hover:text-white/60 transition-colors no-underline">About</a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('menu-toggle')?.addEventListener('click', function() {
        const menu = document.getElementById('mobile-menu');
        const openIcon = this.querySelector('.menu-icon-open');
        const closeIcon = this.querySelector('.menu-icon-close');
        if (!menu || !openIcon || !closeIcon) return;
        const expanded = this.getAttribute('aria-expanded') === 'true';
        this.setAttribute('aria-expanded', String(!expanded));
        menu.classList.toggle('hidden');
        openIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
