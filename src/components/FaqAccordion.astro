---
const { faqs } = Astro.props;
---
<div id="faq-section">
  {faqs.map((faq, i) => (
    <div class="faq-item">
      <button class="faq-trigger" aria-expanded="false" onclick="this.querySelector('svg').style.transform = this.getAttribute('aria-expanded') === 'true' ? 'rotate(0)' : 'rotate(180deg)'; this.setAttribute('aria-expanded', this.getAttribute('aria-expanded') === 'true' ? 'false' : 'true'); this.nextElementSibling.classList.toggle('open')">
        <span>{faq.q}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
      </button>
      <div class="faq-content">
        <div class="faq-content-inner">{faq.a}</div>
      </div>
    </div>
  ))}
</div>
