---
const { title, subtitle, cta, imageUrl } = Astro.props;
const altTitle = title.replace(/<[^>]*>/g, ', ') || title;
---

<section class="relative min-h-[90dvh] flex items-center">
  <div class="absolute inset-0">
    {imageUrl ? (
      <img src={imageUrl} alt={altTitle} class="w-full h-full object-cover" loading="eager" fetchpriority="high" width="1200" height="800" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 100vw, 1200px" />
    ) : (
      <div class="w-full h-full bg-gradient-to-br from-slate-800 via-slate-700 to-[#9e4730]"></div>
    )}
    <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/40 to-transparent"></div>
  </div>
  <div class="relative max-w-7xl mx-auto px-6 w-full pt-16">
    <div class="max-w-2xl">
      <span class="inline-block text-sm font-semibold text-white/80 mb-4 tracking-wide uppercase">
        Potala Palace &middot; Lhasa &middot; Tibet
      </span>
      <h1 class="text-4xl md:text-6xl font-bold text-white leading-[1.05] tracking-tight mb-6" set:html={title} />
      <p class="text-lg text-white/80 max-w-xl leading-relaxed mb-8">{subtitle}</p>
      {cta && <a href={cta.href} class="btn-primary text-base">{cta.label}</a>}
    </div>
  </div>
</section>

