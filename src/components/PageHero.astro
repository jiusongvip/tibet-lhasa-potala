---
const { title, subtitle, breadcrumb, updated, image } = Astro.props;
---
<section class="border-b border-[var(--color-border)] relative overflow-hidden" style="background:var(--color-surface-alt);">
  {image && (
    <img src={image} alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover opacity-15" loading="eager" />
  )}
  <div class="relative max-w-4xl mx-auto px-6 md:px-10 py-14 md:py-20">
    <nav class="flex items-center gap-1.5 text-xs text-[var(--color-text-muted)] mb-6 tracking-[0.04em] uppercase" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[var(--color-accent)] transition-colors no-underline">Home</a>
      <span class="text-[var(--color-text-subtle)]">/</span>
      {breadcrumb ? (
        <span class="text-[var(--color-text)] font-medium">{breadcrumb}</span>
      ) : (
        <span class="text-[var(--color-text)] font-medium">{title}</span>
      )}
    </nav>
    <h1 class="text-3xl md:text-5xl font-[var(--font-display)] font-medium tracking-[-0.02em] text-[var(--color-text)] mb-4 leading-[1.15]">{title}</h1>
    {subtitle && <p class="text-base md:text-lg text-[var(--color-text-muted)] max-w-2xl leading-relaxed font-[var(--font-sans)]">{subtitle}</p>}
    {updated && <p class="text-[0.6875rem] text-[var(--color-text-subtle)] mt-6 uppercase tracking-[0.06em]">Updated: {updated}</p>}
  </div>
</section>
