---
const { title, subtitle, breadcrumb, updated } = Astro.props;
---
<section class="bg-[var(--color-surface-alt)] border-b border-[var(--color-border)]">
  <div class="max-w-4xl mx-auto px-4 md:px-6 py-12 md:py-16">
    <nav class="flex items-center gap-1.5 text-sm text-[var(--color-text-muted)] mb-4" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[var(--color-accent)] transition-colors">Home</a>
      <span class="mx-1 text-[var(--color-text-subtle)]">/</span>
      {breadcrumb ? (
        <span class="text-[var(--color-text)] font-medium">{breadcrumb}</span>
      ) : (
        <span class="text-[var(--color-text)] font-medium">{title}</span>
      )}
    </nav>
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-[var(--color-text)] mb-3">{title}</h1>
    {subtitle && <p class="text-base md:text-lg text-[var(--color-text-muted)] max-w-2xl leading-relaxed">{subtitle}</p>}
    {updated && <p class="text-xs text-[var(--color-text-subtle)] mt-4">Updated: {updated}</p>}
  </div>
</section>
