---
import { getAuthor } from "../data/authors";
import type { Author } from "../data/authors";

interface Props {
  slug: string;
  datePublished?: string;
  dateModified?: string;
}

const { slug, datePublished, dateModified } = Astro.props;
const author = getAuthor(slug);
---

{author && (
  <div class="author-bio-card">
    {author.photoUrl && (
      <img
        class="author-photo"
        src={author.photoUrl}
        alt={`Photo of ${author.name}`}
        width="72"
        height="72"
        loading="lazy"
      />
    )}
    <div class="author-info">
      <p class="author-name">{author.name}</p>
      <p class="author-title">{author.title}</p>
      {author.credentials.length > 0 && (
        <ul class="author-creds">
          {author.credentials.map((cred) => <li>{cred}</li>)}
        </ul>
      )}
      <p class="author-bio">{author.bio}</p>
      {(datePublished || dateModified) && (
        <div class="author-dates">
          {datePublished && <span>Published: {datePublished}</span>}
          {dateModified && <span class="author-dates-sep">·</span>}
          {dateModified && <span>Updated: {dateModified}</span>}
        </div>
      )}
    </div>
  </div>
)}

<style>
  .author-bio-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.75rem;
    margin-top: 2rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .author-photo {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
  }
  .author-info {
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .author-name {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-text);
    margin: 0 0 0.125rem;
    font-family: var(--font-display);
  }
  .author-title {
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 500;
    margin: 0 0 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .author-creds {
    margin: 0 0 0.5rem;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.6rem;
  }
  .author-creds li {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    background: #F9F8F6;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--color-border);
  }
  .author-bio {
    margin: 0.5rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }
  .author-dates {
    margin-top: 0.625rem;
    font-size: 0.6875rem;
    color: var(--color-text-subtle);
    letter-spacing: 0.03em;
  }
  .author-dates-sep {
    margin: 0 0.4rem;
  }
</style>
